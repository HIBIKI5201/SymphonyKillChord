{
  "notion-spec-sync": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node ../scripts/harness/session-start.mjs",
        "timeout": 15
      }
    ]
  },
  "unity-preflight": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ../scripts/harness/unity-preflight.mjs --hook --target=antigravity",
            "timeout": 90
          }
        ]
      }
    ]
  }
}
