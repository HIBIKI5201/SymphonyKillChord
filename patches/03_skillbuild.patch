+        private static int ExtractSkillNumber(string displayName)
+        {
+            if (string.IsNullOrEmpty(displayName))
+            {
+                return int.MaxValue;
+            }
+
+            int end = displayName.Length;
+            int start = end;
+            while (start > 0 && char.IsDigit(displayName[start - 1]))
+            {
+                start--;
+            }
+
+            if (start == end)
