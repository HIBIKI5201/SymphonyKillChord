---
import Layout from '../layouts/Layout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PageHeader from '../components/PageHeader.astro';
import CreditCategory from '../components/CreditCategory.astro';
// クレジットの正本はゲームと共有している Assets/StreamingAssets/Credits/credits.json である。
// サイトはカテゴリ・役職・名前・リードだけを表示し、読み仮名・役職表記・所属はゲーム側で使う。
import credits from '../../../Assets/StreamingAssets/Credits/credits.json';
---

<Layout title="クレジット | Symphony Kill Chord" description="Symphony Kill Chordの制作スタッフ一覧。">
	<main>
		<PageHeader eyebrow="Credit" title="クレジット" />

		<section id="credit-list">
			{credits.categories.map((entry) => <CreditCategory category={entry.category} roles={entry.roles} />)}
		</section>
	</main>

	<SiteFooter />
</Layout>

<style>
	main {
		width: 100%;
		max-width: 720px;
		margin: 0 auto;
		padding: 0 24px 96px;
	}

	#credit-list {
		border-top: 1px solid var(--color-surface-border);
	}
</style>
