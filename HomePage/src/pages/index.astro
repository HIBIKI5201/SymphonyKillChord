---
import Layout from '../layouts/Layout.astro';
import ScanlineOverlay from '../components/ScanlineOverlay.astro';
import SiteFooter from '../components/SiteFooter.astro';

const testText = 'この文章は、テストです。1〜　⭐️';
---

<Layout>
	<ScanlineOverlay />
	<main>
		<section id="hero">
			<p id="eyebrow">Rhythm Action</p>
			<h1>Symphony Kill Chord</h1>
			<p id="catch">独自のビートを刻み、KillChordで爽快にキルを重ねろ。</p>
		</section>

		<section id="type-scale">
			<h1>{testText}</h1>
			<h2>{testText}</h2>
			<h3>{testText}</h3>
			<h4>{testText}</h4>
			<p class="body-mono">{testText}</p>
			<p class="body-text">{testText}</p>
			<p class="body-small">{testText}</p>
		</section>

	</main>

	<SiteFooter />
</Layout>

<style>
	main {
		max-width: 960px;
		margin: 0 auto;
		padding: 0 24px;
		background: #ffffff;
		color: #111827;
	}

	#hero {
		padding: 48px 24px 64px;
		margin: 0 -24px;
		text-align: center;
		background-image: linear-gradient(rgba(10, 13, 11, 0.55), rgba(10, 13, 11, 0.55)),
			url('../assets/images/title_steel.jpg');
		background-size: cover;
		background-position: center;
	}

	#eyebrow {
		margin: 0 0 8px;
		font-family: var(--font-mono);
		letter-spacing: var(--tracking-label);
		font-size: 13px;
		font-weight: 600;
		color: var(--color-signal);
		text-transform: uppercase;
	}

	h1 {
		margin: 0 0 16px;
		font-family: var(--font-display);
		letter-spacing: var(--tracking-display);
		font-size: clamp(2rem, 6vw, 3.5rem);
		font-weight: 800;
	}

	#hero h1 {
		color: var(--color-text-primary);
	}

	#catch {
		margin: 0;
		font-family: var(--font-body);
		font-size: 18px;
		color: var(--color-text-primary);
	}

	#type-scale {
		padding: 48px 0;
		border-top: 1px dashed #d1d5db;
		display: flex;
		flex-direction: column;
		gap: 20px;
	}

	#type-scale h1 {
		font-size: 3rem;
	}

	#type-scale h2 {
		margin: 0;
		font-family: var(--font-display);
		letter-spacing: var(--tracking-display);
		font-size: 2.25rem;
		font-weight: 700;
	}

	#type-scale h3 {
		margin: 0;
		font-family: var(--font-mono);
		letter-spacing: var(--tracking-label);
		font-size: 1.5rem;
		font-weight: 600;
		color: var(--color-signal-dim);
	}

	#type-scale h4 {
		margin: 0;
		font-family: var(--font-body);
		font-size: 1.125rem;
		font-weight: 700;
	}

	#type-scale .body-mono {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 1rem;
		color: var(--color-warning);
	}

	#type-scale .body-text {
		margin: 0;
		font-family: var(--font-body);
		font-size: 1rem;
		color: #374151;
	}

	#type-scale .body-small {
		margin: 0;
		font-family: var(--font-body);
		font-size: 0.8125rem;
		color: #6b7280;
	}

</style>
