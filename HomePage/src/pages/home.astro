---
import Layout from '../layouts/Layout.astro';
import ScanlineOverlay from '../components/ScanlineOverlay.astro';
import SiteFooter from '../components/SiteFooter.astro';
import HeroSection from '../components/HeroSection.astro';
import GameplayVideoSection from '../components/GameplayVideoSection.astro';
import HomeTeaserDesk from '../components/HomeTeaserDesk.astro';
import characters from '../data/characters.json';
import gameplayFeatures from '../data/gameplayFeatures.json';
import symphonyImage from '../assets/images/characters/symphony立ち絵-ポーズ差分.png';
---

<Layout>
	<ScanlineOverlay />
	<main>
		<HeroSection title="Symphony Kill Chord" />

		<GameplayVideoSection src={`${import.meta.env.BASE_URL}movies/GamePV.mp4`} />

		<HomeTeaserDesk
			character={{
				name: characters[0].name,
				formalName: characters[0].formalName,
				image: symphonyImage,
				href: `${import.meta.env.BASE_URL}character`,
			}}
			gameplay={{
				title: 'ゲームプレイ',
				orderNumber: '047',
				items: gameplayFeatures.map((feature) => feature.name),
				href: `${import.meta.env.BASE_URL}gameplay`,
			}}
			skill={{
				title: 'スキル',
				code: 'SKILL-DOSSIER',
				description:
					'拍とアクションの組み合わせで発動する、攻撃・バフ・デバフのスキル。スキルツリーで解放・強化していく。',
				href: `${import.meta.env.BASE_URL}gameplay#skill`,
			}}
		/>
	</main>

	<SiteFooter />
</Layout>

<style>
	main {
		width: 100%;
		max-width: 960px;
		margin: 0 auto;
		padding: 0 24px;
	}
</style>
