---
import Layout from '../layouts/Layout.astro';
import ScanlineOverlay from '../components/ScanlineOverlay.astro';
import SiteFooter from '../components/SiteFooter.astro';
import HeroSection from '../components/HeroSection.astro';
import GameplayVideoSection from '../components/GameplayVideoSection.astro';
import PageTeaser from '../components/PageTeaser.astro';
---

<Layout>
	<ScanlineOverlay />
	<main>
		<HeroSection
			eyebrow="Rhythm Action"
			title="Symphony Kill Chord"
			catchphrase="独自のビートを刻み、KillChordで爽快にキルを重ねろ。"
		/>

		<GameplayVideoSection src="/movies/DummyData.mp4" />

		<PageTeaser title="キャラクター" catchphrase="彼らの物語を知る" href="/character" />
		<PageTeaser title="ゲームプレイ" catchphrase="独自のビートで戦え" href="/gameplay" />
		<PageTeaser title="スキル" catchphrase="一撃の可能性を広げる" href="/skill" />
	</main>

	<SiteFooter />
</Layout>

<style>
	main {
		max-width: 960px;
		margin: 0 auto;
		padding: 0 24px;
	}
</style>
