---
import { getImage } from 'astro:assets';
import skillIcon1 from '../assets/images/ui/UI_Skll1_8.8.png';
import skillIcon2 from '../assets/images/ui/UI_Skll2_8.8.png';
import skillIcon3 from '../assets/images/ui/UI_Skll3_8.8.png';

const icons = await Promise.all(
	[skillIcon1, skillIcon2, skillIcon3].map((src) => getImage({ src, format: 'webp', width: 200, quality: 80 })),
);
---

<article class="slide">
	<p class="code">SKILL-DOSSIER</p>
	<h2 class="name">スキル</h2>

	<ul class="icons">
		{
			icons.map((icon) => (
				<li>
					<img src={icon.src} alt="" width={icon.attributes.width} height={icon.attributes.height} />
				</li>
			))
		}
	</ul>

	<p class="description">
		移動・射撃・回避の拍が組み合わさって発動する「キルコード」によって、攻撃・バフ・デバフのスキルが発動する。使用できるスキルはスキルツリーで解放・強化していく方式で、装備できる枠数には限りがあるため、戦況に応じた組み合わせの選択が重要になる。
	</p>
</article>

<style>
	.slide {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		height: 100%;
		max-width: 800px;
		margin: 0 auto;
		padding: 48px 16px;
		text-align: center;
	}

	.code {
		margin: 0;
		font-family: var(--font-mono);
		letter-spacing: var(--tracking-label);
		font-size: 12px;
		color: var(--color-label-muted);
		text-transform: uppercase;
	}

	.name {
		margin: 8px 0 0;
		font-family: var(--font-display);
		letter-spacing: var(--tracking-display);
		font-size: clamp(1.375rem, 3vw, 1.75rem);
		font-weight: 800;
		color: var(--color-text-primary);
	}

	.icons {
		display: flex;
		justify-content: center;
		gap: 24px;
		margin: 32px 0 0;
		padding: 0;
		list-style: none;
	}

	.icons img {
		width: 96px;
		height: 96px;
		opacity: 0.9;
	}

	.description {
		margin: 24px 0 0;
		max-width: 52ch;
		font-size: 0.9375rem;
		line-height: 1.9;
		color: var(--color-text-muted);
	}

	@media (max-width: 767px) {
		.icons {
			gap: 16px;
		}

		.icons img {
			width: 72px;
			height: 72px;
		}
	}
</style>
