---
import GameplayRing from './GameplayRing.astro';

interface Segment {
	value: string;
	caption: string;
	locked?: boolean;
}

interface Props {
	code: string;
	name: string;
	description: string;
	ringLabel: string;
	ringSegments: Segment[];
}

const { code, name, description, ringLabel, ringSegments } = Astro.props;
---

<article class="slide">
	<div class="visual">
		<GameplayRing label={ringLabel} segments={ringSegments} />
	</div>

	<div class="body">
		<p class="code">{code}</p>
		<h2 class="name">{name}</h2>
		<p class="description">{description}</p>
	</div>
</article>

<style>
	.slide {
		display: grid;
		grid-template-columns: 240px minmax(0, 460px);
		align-items: center;
		justify-content: center;
		gap: 48px;
		height: 100%;
		max-width: 800px;
		margin: 0 auto;
		padding: 48px 16px;
	}

	.visual {
		display: flex;
		justify-content: center;
	}

	.code {
		margin: 0;
		font-family: var(--font-mono);
		letter-spacing: var(--tracking-label);
		font-size: 12px;
		color: var(--color-signal-dim);
		text-transform: uppercase;
	}

	.name {
		margin: 8px 0 0;
		font-family: var(--font-display);
		letter-spacing: var(--tracking-display);
		font-size: clamp(1.375rem, 3vw, 1.75rem);
		font-weight: 800;
		color: var(--color-text-primary);
	}

	.description {
		margin: 16px 0 0;
		max-width: 52ch;
		font-size: 0.9375rem;
		line-height: 1.9;
		color: var(--color-text-muted);
	}

	@media (max-width: 767px) {
		.slide {
			grid-template-columns: 1fr;
			text-align: center;
			padding: 32px 8px;
		}

		.description {
			margin-left: auto;
			margin-right: auto;
		}
	}
</style>
