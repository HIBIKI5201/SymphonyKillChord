---
interface Props {
	eyebrow: string;
	title: string;
	src: string;
}

const { eyebrow, title, src } = Astro.props;
---

<section id="gameplay-video">
	<p class="eyebrow">{eyebrow}</p>
	<h2>{title}</h2>
	<video src={src} autoplay loop muted playsinline></video>
</section>

<style>
	#gameplay-video {
		padding: 64px 0;
		text-align: center;
		background: var(--color-bg);
		margin: 0 -24px;
		padding-left: 24px;
		padding-right: 24px;
	}

	h2 {
		margin: 0 0 32px;
		font-family: var(--font-display);
		letter-spacing: var(--tracking-display);
		font-size: clamp(1.5rem, 4vw, 2.25rem);
		font-weight: 800;
		color: var(--color-text-primary);
	}

	video {
		width: 100%;
		max-width: 800px;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		border: 1px solid var(--color-surface-border);
	}
</style>
