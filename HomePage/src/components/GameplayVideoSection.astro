---
interface Props {
	src: string;
}

const { src } = Astro.props;
---

<section id="gameplay-video">
	<video src={src} autoplay loop muted playsinline></video>
</section>

<style>
	#gameplay-video {
		padding: 64px 0;
		text-align: center;
		background: var(--color-bg);
		margin: 0 -24px;
		padding-left: 24px;
		padding-right: 24px;
	}

	video {
		width: 100%;
		max-width: 800px;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		border: 1px solid var(--color-surface-border);
	}
</style>
