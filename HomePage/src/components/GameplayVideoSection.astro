---
import { getImage } from 'astro:assets';
import posterImage from '../assets/images/gameplay/GamePV_poster.jpg';

interface Props {
	src: string;
}

const { src } = Astro.props;

const poster = await getImage({ src: posterImage, format: 'webp', width: 800, quality: 75 });
---

<section id="gameplay-video">
	<video data-src={src} poster={poster.src} loop muted playsinline preload="none"></video>
</section>

<script>
	const video = document.querySelector<HTMLVideoElement>('#gameplay-video video');

	if (video) {
		const dataSrc = video.dataset.src;

		// 画面に入るまで読み込みを遅延させ、初回表示時のダウンロード量を抑える
		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting && dataSrc) {
						video.src = dataSrc;
						video.play().catch(() => {});
						observer.unobserve(video);
					}
				});
			},
			{ rootMargin: '200px' },
		);

		observer.observe(video);
	}
</script>

<style>
	#gameplay-video {
		padding: 64px 0;
		text-align: center;
		background: var(--color-bg);
		margin: 0 -24px;
		padding-left: 24px;
		padding-right: 24px;
	}

	video {
		width: 100%;
		max-width: 800px;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		border: 1px solid var(--color-surface-border);
	}
</style>
