---
interface NavItem {
	label: string;
	href: string;
}

interface Props {
	navItems?: NavItem[];
}

const {
	navItems = [
		{ label: 'ホーム', href: '/' },
		{ label: 'キャラクター', href: '/character' },
		{ label: 'ゲームプレイ', href: '/gameplay' },
		{ label: 'スキル', href: '/skill' },
		{ label: 'クレジット', href: '/credit' },
	],
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<header class="site-header">
	<a class="brand" href="/">Symphony Kill Chord</a>
	<nav class="nav">
		{
			navItems.map((item) => (
				<a class="nav-link" href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>
					{item.label}
				</a>
			))
		}
	</nav>
</header>

<style>
	.site-header {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 50;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		height: 64px;
		padding: 0 24px;
		background: rgba(10, 13, 11, 0.72);
		backdrop-filter: blur(6px);
		border-bottom: 1px solid var(--color-surface-border);
	}

	.brand {
		font-family: var(--font-display);
		letter-spacing: var(--tracking-display);
		font-size: 16px;
		font-weight: 800;
		color: var(--color-text-primary);
		text-decoration: none;
		white-space: nowrap;
	}

	.nav {
		display: flex;
		gap: 24px;
		overflow-x: auto;
	}

	.nav-link {
		font-family: var(--font-mono);
		letter-spacing: var(--tracking-label);
		font-size: 12px;
		color: var(--color-text-muted);
		text-decoration: none;
		text-transform: uppercase;
		white-space: nowrap;
		transition: color 0.2s ease;
	}

	.nav-link:hover {
		color: var(--color-signal);
	}

	.nav-link[aria-current='page'] {
		color: var(--color-signal);
	}
</style>
