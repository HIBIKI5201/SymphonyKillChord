---
import logoSrc from '../assets/images/logo/Title_Logo.png';
import homeIcon from '../assets/icons/nav-home.svg?raw';
import characterIcon from '../assets/icons/nav-character.svg?raw';
import gameplayIcon from '../assets/icons/nav-gameplay.svg?raw';
import skillIcon from '../assets/icons/nav-skill.svg?raw';
import creditIcon from '../assets/icons/nav-credit.svg?raw';

interface NavItem {
	label: string;
	href: string;
	icon: string;
}

interface Props {
	navItems?: NavItem[];
}

const {
	navItems = [
		{ label: 'Home', href: `${import.meta.env.BASE_URL}home`, icon: homeIcon },
		{ label: 'Character', href: `${import.meta.env.BASE_URL}character`, icon: characterIcon },
		{ label: 'Gameplay', href: `${import.meta.env.BASE_URL}gameplay`, icon: gameplayIcon },
		{ label: 'Skill', href: `${import.meta.env.BASE_URL}skill`, icon: skillIcon },
		{ label: 'Credit', href: `${import.meta.env.BASE_URL}credit`, icon: creditIcon },
	],
} = Astro.props;

// ビルド出力(directory形式)ではAstro.url.pathnameが末尾スラッシュ付きになるため、
// 比較前に両者から末尾スラッシュを取り除いて揃える。
const normalize = (path: string) => path.replace(/\/$/, '');
const currentPath = normalize(Astro.url.pathname);
---

<header class="site-header">
	<a class="brand" href={`${import.meta.env.BASE_URL}home`}>
		<img class="brand-logo" src={logoSrc.src} alt="Symphony Kill Chord" />
	</a>

	<nav class="nav" id="site-nav">
		{
			navItems.map((item) => (
				<a class="nav-link" href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>
					<span class="nav-icon" set:html={item.icon} />
					<span class="nav-label">{item.label}</span>
				</a>
			))
		}
	</nav>

	<button
		class="menu-toggle"
		id="menu-toggle"
		type="button"
		aria-expanded="false"
		aria-controls="mobile-nav"
		aria-label="メニューを開く"
	>
		<span></span>
		<span></span>
		<span></span>
	</button>

	<nav class="mobile-nav" id="mobile-nav" data-open="false">
		{
			navItems.map((item) => (
				<a class="mobile-nav-link" href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>
					<span class="nav-icon" set:html={item.icon} />
					<span class="nav-label">{item.label}</span>
				</a>
			))
		}
	</nav>
</header>

<style>
	/*
	 * デスクトップでは左サイドの縦ナビ(ホバーで展開)、
	 * モバイルでは従来通り上部の固定バー+ハンバーガーメニューに切り替える。
	 */
	.site-header {
		position: fixed;
		top: 0;
		left: 0;
		z-index: 50;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 32px;
		width: var(--side-nav-width);
		height: 100vh;
		padding: 20px 0;
		background: rgba(10, 13, 11, 0.85);
		backdrop-filter: blur(6px);
		border-right: 1px solid var(--color-surface-border);
		overflow: hidden;
		transition:
			width 0.25s ease,
			background 0.25s ease;
	}

	.site-header:hover,
	.site-header:focus-within {
		width: 200px;
	}

	.brand {
		flex-shrink: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		text-decoration: none;
	}

	.brand-logo {
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	.nav {
		display: flex;
		flex-direction: column;
		width: 100%;
	}

	.nav-link {
		display: flex;
		align-items: center;
		gap: 14px;
		width: 100%;
		padding: 14px 24px;
		font-family: var(--font-mono);
		letter-spacing: var(--tracking-label);
		font-size: 12px;
		color: var(--color-text-muted);
		text-decoration: none;
		text-transform: uppercase;
		white-space: nowrap;
		transition: color 0.2s ease;
	}

	.nav-link:hover {
		color: var(--color-signal);
	}

	.nav-link[aria-current='page'] {
		color: var(--color-signal);
	}

	.nav-icon {
		flex-shrink: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 20px;
		height: 20px;
	}

	.nav-icon :global(svg) {
		width: 100%;
		height: 100%;
	}

	.nav-link .nav-label {
		opacity: 0;
		transition: opacity 0.2s ease;
	}

	.site-header:hover .nav-link .nav-label,
	.site-header:focus-within .nav-link .nav-label {
		opacity: 1;
	}

	.menu-toggle {
		display: none;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		gap: 5px;
		width: 32px;
		height: 32px;
		padding: 0;
		border: none;
		background: transparent;
		cursor: pointer;
	}

	.menu-toggle span {
		display: block;
		width: 22px;
		height: 2px;
		background: var(--color-text-primary);
		transition:
			transform 0.2s ease,
			opacity 0.2s ease;
	}

	.menu-toggle[aria-expanded='true'] span:nth-child(1) {
		transform: translateY(7px) rotate(45deg);
	}

	.menu-toggle[aria-expanded='true'] span:nth-child(2) {
		opacity: 0;
	}

	.menu-toggle[aria-expanded='true'] span:nth-child(3) {
		transform: translateY(-7px) rotate(-45deg);
	}

	.mobile-nav {
		display: none;
	}

	@media (max-width: 767px) {
		.site-header {
			flex-direction: row;
			align-items: center;
			justify-content: space-between;
			width: 100%;
			height: var(--header-height-mobile);
			padding: 0 24px;
			border-right: none;
			border-bottom: 1px solid var(--color-surface-border);
			overflow: visible;
		}

		.site-header:hover,
		.site-header:focus-within {
			width: 100%;
		}

		.brand {
			width: auto;
			height: 52px;
		}

		.nav {
			display: none;
		}

		.menu-toggle {
			display: flex;
		}

		.mobile-nav {
			position: fixed;
			top: var(--header-height-mobile);
			left: 0;
			right: 0;
			z-index: 49;
			flex-direction: column;
			background: rgba(10, 13, 11, 0.96);
			border-bottom: 1px solid var(--color-surface-border);
			max-height: 0;
			overflow: hidden;
			transition: max-height 0.25s ease;
		}

		.mobile-nav[data-open='true'] {
			display: flex;
			max-height: 400px;
		}

		.mobile-nav-link {
			display: flex;
			align-items: center;
			gap: 14px;
			padding: 16px 24px;
			font-family: var(--font-mono);
			letter-spacing: var(--tracking-label);
			font-size: 13px;
			color: var(--color-text-muted);
			text-decoration: none;
			text-transform: uppercase;
			border-top: 1px solid var(--color-surface-border);
		}

		.mobile-nav-link .nav-icon {
			flex-shrink: 0;
			width: 18px;
			height: 18px;
		}

		.mobile-nav-link:first-child {
			border-top: none;
		}

		.mobile-nav-link[aria-current='page'] {
			color: var(--color-signal);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.site-header {
			transition: none;
		}
	}
</style>

<script>
	const toggle = document.getElementById('menu-toggle');
	const mobileNav = document.getElementById('mobile-nav');

	if (toggle && mobileNav) {
		toggle.addEventListener('click', () => {
			const isOpen = mobileNav.dataset.open === 'true';
			mobileNav.dataset.open = String(!isOpen);
			toggle.setAttribute('aria-expanded', String(!isOpen));
			toggle.setAttribute('aria-label', isOpen ? 'メニューを開く' : 'メニューを閉じる');
		});

		mobileNav.querySelectorAll('a').forEach((link) => {
			link.addEventListener('click', () => {
				mobileNav.dataset.open = 'false';
				toggle.setAttribute('aria-expanded', 'false');
				toggle.setAttribute('aria-label', 'メニューを開く');
			});
		});
	}
</script>
