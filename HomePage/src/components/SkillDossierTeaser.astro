---
interface Props {
	title: string;
	code: string;
	description: string;
	href: string;
}

const { title, code, description, href } = Astro.props;
---

<a class="dossier" href={href}>
	<span class="punch punch-left" aria-hidden="true"></span>
	<span class="punch punch-right" aria-hidden="true"></span>
	<span class="approval">稼働中</span>

	<p class="code">{code}</p>
	<h2 class="title">{title}</h2>

	<p class="description">{description}</p>
</a>

<style>
	/*
	 * 技術仕様カード(索引カード)を模した紙質のため、
	 * キャラファイル・指令書とは別トーンのローカル変数を定義する。
	 */
	.dossier {
		--card-bg: #e8e0c8;
		--card-bg-alt: #ded4b4;
		--card-ink: #2c2418;
		--card-ink-muted: #6b5f45;
		--card-border: #a8996b;

		position: relative;
		display: block;
		width: 100%;
		max-width: 320px;
		padding: 36px 24px 24px;
		text-align: left;
		background: linear-gradient(180deg, var(--card-bg) 0%, var(--card-bg-alt) 100%);
		border: 1px solid var(--card-border);
		box-shadow: 0 18px 32px rgba(0, 0, 0, 0.45);
		text-decoration: none;
	}

	.punch {
		position: absolute;
		top: 14px;
		width: 12px;
		height: 12px;
		border-radius: 50%;
		background: var(--color-bg);
		box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.5);
	}

	.punch-left {
		left: 24px;
	}

	.punch-right {
		right: 24px;
	}

	.approval {
		position: absolute;
		bottom: 20px;
		right: 20px;
		width: 56px;
		height: 56px;
		display: flex;
		align-items: center;
		justify-content: center;
		border: 2px solid var(--color-signal-dim);
		border-radius: 50%;
		font-family: var(--font-mono);
		font-size: 10px;
		font-weight: 700;
		letter-spacing: var(--tracking-label);
		color: var(--color-signal-dim);
		transform: rotate(-10deg);
		opacity: 0.85;
		text-align: center;
	}

	.code {
		margin: 0;
		font-family: var(--font-mono);
		letter-spacing: var(--tracking-label);
		font-size: 11px;
		color: var(--card-ink-muted);
		text-transform: uppercase;
	}

	.title {
		margin: 8px 0 0;
		font-family: var(--font-display);
		letter-spacing: var(--tracking-display);
		font-size: 1.375rem;
		font-weight: 800;
		color: var(--card-ink);
	}

	.description {
		margin: 20px 72px 0 0;
		padding-top: 12px;
		border-top: 1px dashed var(--card-border);
		font-family: var(--font-mono);
		font-size: 12px;
		line-height: 1.7;
		color: var(--card-ink-muted);
	}
</style>
