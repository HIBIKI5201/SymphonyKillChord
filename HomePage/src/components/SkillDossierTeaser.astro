---
interface Props {
	title: string;
	code: string;
	skills: string[];
	href: string;
}

const { title, code, skills, href } = Astro.props;
---

<section id="skill-dossier">
	<a class="dossier" href={href}>
		<span class="punch punch-left" aria-hidden="true"></span>
		<span class="punch punch-right" aria-hidden="true"></span>
		<span class="approval">稼働中</span>

		<p class="code">{code}</p>
		<h2 class="title">{title}</h2>

		<dl class="rows">
			{
				skills.map((skill) => (
					<div class="row">
						<dt>{skill}</dt>
						<dd>未設定</dd>
					</div>
				))
			}
		</dl>
	</a>
</section>

<style>
	/*
	 * 技術仕様カード(索引カード)を模した紙質のため、
	 * キャラファイル・指令書とは別トーンのローカル変数を定義する。
	 */
	#skill-dossier {
		--card-bg: #e8e0c8;
		--card-bg-alt: #ded4b4;
		--card-ink: #2c2418;
		--card-ink-muted: #6b5f45;
		--card-border: #a8996b;

		padding: 80px 24px;
		text-align: center;
		background: var(--color-bg);
		margin: 0 -24px;
	}

	.dossier {
		position: relative;
		display: inline-block;
		width: min(320px, 84vw);
		padding: 36px 24px 24px;
		text-align: left;
		background: linear-gradient(180deg, var(--card-bg) 0%, var(--card-bg-alt) 100%);
		border: 1px solid var(--card-border);
		box-shadow: 0 18px 32px rgba(0, 0, 0, 0.45);
		text-decoration: none;
		transition:
			transform 0.3s ease,
			box-shadow 0.3s ease;
	}

	.dossier:hover {
		transform: translateY(-6px);
		box-shadow: 0 24px 40px rgba(0, 0, 0, 0.55);
	}

	.punch {
		position: absolute;
		top: 14px;
		width: 12px;
		height: 12px;
		border-radius: 50%;
		background: var(--color-bg);
		box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.5);
	}

	.punch-left {
		left: 24px;
	}

	.punch-right {
		right: 24px;
	}

	.approval {
		position: absolute;
		bottom: 20px;
		right: 20px;
		width: 56px;
		height: 56px;
		display: flex;
		align-items: center;
		justify-content: center;
		border: 2px solid var(--color-signal-dim);
		border-radius: 50%;
		font-family: var(--font-mono);
		font-size: 10px;
		font-weight: 700;
		letter-spacing: var(--tracking-label);
		color: var(--color-signal-dim);
		transform: rotate(-10deg);
		opacity: 0.85;
		text-align: center;
	}

	.code {
		margin: 0;
		font-family: var(--font-mono);
		letter-spacing: var(--tracking-label);
		font-size: 11px;
		color: var(--card-ink-muted);
		text-transform: uppercase;
	}

	.title {
		margin: 8px 0 0;
		font-family: var(--font-display);
		letter-spacing: var(--tracking-display);
		font-size: 1.375rem;
		font-weight: 800;
		color: var(--card-ink);
	}

	.rows {
		margin: 20px 0 0;
		padding-top: 12px;
		padding-right: 72px;
		border-top: 1px dashed var(--card-border);
	}

	.row {
		display: flex;
		justify-content: space-between;
		gap: 12px;
		margin: 0 0 8px;
	}

	.row:last-child {
		margin-bottom: 0;
	}

	.row dt {
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--card-ink);
	}

	.row dd {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--card-ink-muted);
	}

	@media (prefers-reduced-motion: reduce) {
		.dossier {
			transition: none;
		}
	}
</style>
