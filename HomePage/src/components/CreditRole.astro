---
interface NameEntry {
	name: string;
	lead?: boolean;
}

interface Props {
	role: string;
	names: NameEntry[];
}

const { role, names } = Astro.props;
---

<section class="credit-role">
	<p class="role-title"><span class="role-marker">◈</span>{role}</p>
	<div class="names">
		{
			names.map((entry, index) => (
				<>
					{index > 0 && <span class="name-divider" aria-hidden="true">/</span>}
					<span class="name">
						{entry.lead && <span class="lead-mark" aria-hidden="true">★</span>}
						{entry.name}
					</span>
				</>
			))
		}
	</div>
</section>

<style>
	.credit-role {
		flex: 1 1 240px;
		padding: 20px 0;
		border-top: 1px solid var(--color-surface-border);
	}

	.role-title {
		margin: 0 0 16px;
		display: flex;
		align-items: center;
		gap: 8px;
		font-family: var(--font-mono);
		letter-spacing: var(--tracking-label);
		font-size: 13px;
		color: var(--color-text-muted);
		text-transform: uppercase;
	}

	.role-marker {
		color: var(--color-text-muted);
	}

	.names {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 8px 12px;
	}

	.name {
		position: relative;
		display: inline-block;
		font-family: var(--font-display);
		letter-spacing: var(--tracking-display);
		font-size: 1.375rem;
		color: var(--color-text-primary);
	}

	.lead-mark {
		position: absolute;
		top: -2px;
		left: -13px;
		font-size: 11px;
		line-height: 1;
		color: var(--color-signal);
	}

	.name-divider {
		color: var(--color-surface-border);
	}
</style>
