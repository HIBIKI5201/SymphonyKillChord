---
import { getImage } from 'astro:assets';
import heroPc from '../assets/images/hero/KeyVisual_PC.png';
import heroMobile from '../assets/images/hero/KeyVisual_Mobile.png';

interface Props {
	title: string;
}

const { title } = Astro.props;

const pcAvif = await getImage({ src: heroPc, format: 'avif', quality: 70 });
const pcWebp = await getImage({ src: heroPc, format: 'webp', quality: 75 });
const mobileAvif = await getImage({ src: heroMobile, format: 'avif', quality: 70 });
const mobileWebp = await getImage({ src: heroMobile, format: 'webp', quality: 75 });
---

<section id="hero">
	<picture class="hero-image">
		<source media="(max-width: 767px)" srcset={mobileAvif.src} type="image/avif" />
		<source media="(max-width: 767px)" srcset={mobileWebp.src} type="image/webp" />
		<source media="(min-width: 768px)" srcset={pcAvif.src} type="image/avif" />
		<source media="(min-width: 768px)" srcset={pcWebp.src} type="image/webp" />
		<img src={pcWebp.src} alt="" fetchpriority="high" loading="eager" decoding="async" />
	</picture>
	<div class="overlay" aria-hidden="true"></div>

	<h1 class="visually-hidden">{title}</h1>
</section>

<style>
	#hero {
		position: relative;
		aspect-ratio: 2000 / 850;
		overflow: hidden;
		margin: 0 -24px;
		background-color: var(--color-bg);
	}

	.hero-image,
	.hero-image img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.hero-image img {
		object-fit: contain;
		object-position: center;
	}

	.overlay {
		position: absolute;
		inset: 0;
		z-index: 1;
		background-image: linear-gradient(180deg, rgba(10, 13, 11, 0) 0%, rgba(10, 13, 11, 0.1) 70%, rgba(10, 13, 11, 0.85) 100%);
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	@media (max-width: 767px) {
		#hero {
			aspect-ratio: auto;
			min-height: calc(100svh - var(--header-height-mobile));
		}

		.hero-image img {
			object-fit: cover;
		}

		.overlay {
			background-image: linear-gradient(180deg, rgba(10, 13, 11, 0) 0%, rgba(10, 13, 11, 0.25) 58%, rgba(10, 13, 11, 0.95) 82%);
		}
	}
</style>
