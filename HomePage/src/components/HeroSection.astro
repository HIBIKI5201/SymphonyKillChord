---
interface Props {
	eyebrow: string;
	title: string;
	catchphrase: string;
}

const { eyebrow, title, catchphrase } = Astro.props;
---

<section id="hero">
	<div class="backdrop"></div>

	<div class="stage">
		<p class="eyebrow">{eyebrow}</p>
		<p id="catch">{catchphrase}</p>
	</div>

	<h1 class="visually-hidden">{title}</h1>
</section>

<style>
	#hero {
		position: relative;
		min-height: 100svh;
		display: flex;
		align-items: flex-end;
		justify-content: center;
		overflow: hidden;
		margin: 0 -24px;
	}

	.backdrop {
		position: absolute;
		inset: 0;
		z-index: 0;
		background-color: var(--color-bg);
		background-image: linear-gradient(180deg, rgba(10, 13, 11, 0) 0%, rgba(10, 13, 11, 0.1) 70%, rgba(10, 13, 11, 0.85) 100%),
			url('../assets/images/hero/KeyVisual_PC.png');
		background-size: contain;
		background-position: center;
		background-repeat: no-repeat;
	}

	.stage {
		position: relative;
		z-index: 1;
		width: 100%;
		max-width: 1200px;
		padding: 0 24px clamp(32px, 8vh, 72px);
		text-align: center;
	}

	.eyebrow {
		margin: 0 0 8px;
	}

	#catch {
		margin: 0;
		font-family: var(--font-body);
		font-size: 18px;
		color: var(--color-text-primary);
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	@media (max-width: 767px) {
		#hero {
			min-height: calc(100svh - var(--header-height-mobile));
		}

		.backdrop {
			background-image: linear-gradient(180deg, rgba(10, 13, 11, 0) 0%, rgba(10, 13, 11, 0.25) 58%, rgba(10, 13, 11, 0.95) 82%),
				url('../assets/images/hero/KeyVisual_Mobile.png');
			background-position: center;
		}

		.stage {
			padding-bottom: 40px;
		}
	}
</style>
