---
import type { ImageMetadata } from 'astro';

interface Props {
	id: string;
	name: string;
	formalName: string;
	catchphrase: string;
	description: string[];
	cv: string;
	image?: ImageMetadata;
	reverse?: boolean;
}

const { id, name, formalName, catchphrase, description, cv, image, reverse = false } = Astro.props;
---

<section class="character-section" id={id} data-reverse={reverse}>
	{
		image ? (
			<div class="bg-image" style={{ backgroundImage: `url("${image.src}")` }} aria-hidden="true" />
		) : (
			<p class="bg-name" aria-hidden="true">
				{name}
			</p>
		)
	}

	<div class="visual" data-has-image={Boolean(image)}>
		{image ? <img src={image.src} alt={name} /> : <span class="no-image">NO IMAGE</span>}
	</div>

	<div class="info">
		<h2 class="name">{name}</h2>
		<p class="formal-name">{formalName}</p>
		<p class="catchphrase">{catchphrase}</p>
		<div class="description">
			{description.map((line) => <p>{line}</p>)}
		</div>
		<p class="cv">CV：{cv}</p>
	</div>
</section>

<style>
	.character-section {
		position: relative;
		display: flex;
		align-items: center;
		gap: 48px;
		padding: 96px 0;
		overflow: hidden;
	}

	.character-section[data-reverse='true'] {
		flex-direction: row-reverse;
	}

	.bg-name {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		margin: 0;
		font-family: var(--font-display);
		letter-spacing: var(--tracking-display);
		font-size: clamp(4rem, 14vw, 12rem);
		font-weight: 800;
		color: var(--color-surface);
		white-space: nowrap;
		z-index: 0;
		pointer-events: none;
	}

	.bg-image {
		position: absolute;
		inset: 0;
		background-repeat: no-repeat;
		background-position: center 15%;
		background-size: contain;
		opacity: 0.14;
		z-index: 0;
		pointer-events: none;
	}

	.visual {
		position: relative;
		z-index: 1;
		flex: 0 0 auto;
		width: min(440px, 48vw);
		aspect-ratio: 3 / 4;
		display: flex;
		align-items: center;
		justify-content: center;
		border: 1px dashed var(--color-surface-border);
		background: var(--color-surface);
		opacity: 0;
		transform: translateX(-48px);
		transition:
			opacity 0.7s ease,
			transform 0.7s ease;
	}

	.character-section[data-reverse='true'] .visual {
		transform: translateX(48px);
	}

	.character-section.is-visible .visual {
		opacity: 1;
		transform: translateX(0);
	}

	.visual[data-has-image='true'] {
		width: min(260px, 28vw);
		aspect-ratio: 2670 / 5576;
		border: none;
		background: none;
	}

	.visual img {
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	.no-image {
		font-family: var(--font-mono);
		letter-spacing: var(--tracking-label);
		font-size: 13px;
		color: var(--color-text-muted);
		text-transform: uppercase;
	}

	.info {
		position: relative;
		z-index: 1;
		flex: 1 1 320px;
	}

	.info > * {
		opacity: 0;
		transform: translateY(24px);
		transition:
			opacity 0.6s ease,
			transform 0.6s ease;
		transition-delay: var(--reveal-delay, 0s);
	}

	.info > *:nth-child(1) {
		--reveal-delay: 0.15s;
	}

	.info > *:nth-child(2) {
		--reveal-delay: 0.25s;
	}

	.info > *:nth-child(3) {
		--reveal-delay: 0.35s;
	}

	.info > *:nth-child(4) {
		--reveal-delay: 0.45s;
	}

	.info > *:nth-child(5) {
		--reveal-delay: 0.55s;
	}

	.character-section.is-visible .info > * {
		opacity: 1;
		transform: translateY(0);
	}

	.name {
		margin: 0;
		font-family: var(--font-display);
		letter-spacing: var(--tracking-display);
		font-size: clamp(1.75rem, 4vw, 2.75rem);
		font-weight: 800;
		color: var(--color-text-primary);
	}

	.formal-name {
		margin: 8px 0 0;
		font-family: var(--font-mono);
		letter-spacing: var(--tracking-label);
		font-size: 13px;
		color: var(--color-signal-dim);
		text-transform: uppercase;
	}

	.catchphrase {
		margin: 24px 0 0;
		font-family: var(--font-display);
		letter-spacing: var(--tracking-display);
		font-size: 1.25rem;
		color: var(--color-signal);
	}

	.description {
		margin-top: 20px;
	}

	.description p {
		margin: 0 0 8px;
		font-size: 0.9375rem;
		line-height: 1.8;
		color: var(--color-text-muted);
	}

	.cv {
		margin: 20px 0 0;
		font-family: var(--font-mono);
		letter-spacing: var(--tracking-label);
		font-size: 13px;
		color: var(--color-text-muted);
	}

	@media (max-width: 767px) {
		.character-section,
		.character-section[data-reverse='true'] {
			flex-direction: column;
			gap: 32px;
			padding: 64px 0;
		}

		.visual {
			width: min(340px, 80vw);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.visual,
		.info > * {
			opacity: 1;
			transform: none;
			transition: none;
		}
	}
</style>

<script>
	const sections = document.querySelectorAll<HTMLElement>('.character-section');

	const observer = new IntersectionObserver(
		(entries) => {
			entries.forEach((entry) => {
				if (entry.isIntersecting) {
					entry.target.classList.add('is-visible');
					observer.unobserve(entry.target);
				}
			});
		},
		{ threshold: 0.2 },
	);

	sections.forEach((section) => observer.observe(section));
</script>
