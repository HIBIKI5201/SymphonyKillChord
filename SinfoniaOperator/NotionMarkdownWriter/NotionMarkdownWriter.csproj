<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SinfoniaStudio.NotionMarkdownWriter</RootNamespace>
    <AssemblyName>NotionMarkdownWriter</AssemblyName>
  </PropertyGroup>

  <!-- 配布用exeはWindows向けの自己完結単一ファイルにする。
       Windows以外ではRIDを固定せず、run-tool.sh から dotnet run でそのまま実行できるようにする。 -->
  <PropertyGroup>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' And '$(OS)' == 'Windows_NT'">win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('win'))">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SinfoniaOperator.Core\SinfoniaOperator.Core.csproj" />
  </ItemGroup>

  <!-- エクスポーターと同じ挙動を保つため、ID解釈・レート制限・API例外はソースを共有する。 -->
  <ItemGroup>
    <Compile Include="..\NotionMarkdownExporter\NotionIdentifier.cs" Link="Shared\NotionIdentifier.cs" />
    <Compile Include="..\NotionMarkdownExporter\NotionApiException.cs" Link="Shared\NotionApiException.cs" />
    <Compile Include="..\NotionMarkdownExporter\RequestRateLimiter.cs" Link="Shared\RequestRateLimiter.cs" />
  </ItemGroup>

  <!-- dotnet publish の完了後、配布用exeをリポジトリ直下（SinfoniaOperator/NotionMarkdownWriter.exe）へ自動コピーする。 -->
  <Target Name="CopyPublishedExeToRepoRoot" AfterTargets="Publish" Condition="$(RuntimeIdentifier.StartsWith('win'))">
    <Copy SourceFiles="$(PublishDir)$(AssemblyName).exe"
          DestinationFolder="$(MSBuildProjectDirectory)/.." />
  </Target>

</Project>
