<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- UnityのRoslynアナライザはnetstandard2.0のDLLのみ読み込める。 -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>SymphonyKillChord.Analyzers</RootNamespace>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!-- リリース追跡ファイルは運用しない。 -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
    <!-- DLLにビルド環境の絶対パスを埋め込まず、どの環境でも同じバイト列になりやすくする。 -->
    <DebugType>none</DebugType>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=/src</PathMap>
  </PropertyGroup>

  <ItemGroup>
    <!-- Unity 6のコンパイラが読み込める最小バージョンに固定する。上げるとUnity側で読み込めなくなる。 -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.0.1" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <!-- アナライザDLLの配置先。Editorフォルダ配下かつ全プラットフォーム無効のためビルドには含まれない。 -->
    <UnityAnalyzerDir>$(MSBuildThisFileDirectory)..\..\Assets\Editor\Roslyn\</UnityAnalyzerDir>
  </PropertyGroup>

  <!-- Releaseビルド後、アナライザ本体のDLLだけをUnityのAssetsへ配置する。Microsoft.CodeAnalysis.*は配置しない。 -->
  <Target Name="CopyToUnity" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <MakeDir Directories="$(UnityAnalyzerDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(UnityAnalyzerDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
