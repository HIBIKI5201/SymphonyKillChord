{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "(GIT_TERMINAL_PROMPT=0 git -C \"$CLAUDE_PROJECT_DIR\" submodule update --init --remote --depth 1 -- Docs/NotionSpecifications > /dev/null 2>&1 &)"
          }
        ]
      }
    ]
  }
}
