{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "(GIT_TERMINAL_PROMPT=0 git -C \"$CLAUDE_PROJECT_DIR\" submodule update --init --remote --depth 1 -- Docs/NotionSpecifications > /dev/null 2>&1 &)"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/harness/unity-preflight.mjs\" --hook",
            "timeout": 90
          }
        ]
      }
    ]
  }
}
