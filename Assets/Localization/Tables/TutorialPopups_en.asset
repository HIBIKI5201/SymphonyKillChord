  m_Name: TutorialPopups_en
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 28ef56a5b71510142b480be2aea60eb6, type: 2}
