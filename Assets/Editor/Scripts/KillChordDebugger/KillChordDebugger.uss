/*
 * KillChord Debugger 共通スタイル。
 * ウィンドウ本体(KillChordDebuggerWindow.uxml)から参照するクラス群です。
 */

.kcd-root {
    flex-grow: 1;
}

.kcd-header {
    padding: 8px 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.35);
    background-color: rgba(0, 0, 0, 0.08);
}

.kcd-header__title {
    font-size: 14px;
    -unity-font-style: bold;
}

.kcd-body {
    flex-direction: row;
    flex-grow: 1;
}

.kcd-nav {
    width: 140px;
    padding: 6px;
    border-right-width: 1px;
    border-right-color: rgba(0, 0, 0, 0.35);
}

.kcd-nav__button {
    margin: 0 0 2px 0;
    -unity-text-align: middle-left;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.kcd-nav__button--active {
    background-color: rgba(58, 121, 187, 0.5);
    -unity-font-style: bold;
}

.kcd-content {
    flex-grow: 1;
}
