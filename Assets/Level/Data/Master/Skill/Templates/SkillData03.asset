  _skillDetail: "\u30BF\u30FC\u30B2\u30C3\u30C8\u306B\u5BFE\u3057\u3066\u5358\u767A\u9AD8\u706B\u529B\uFF08\u901A\u5E38\u653B\u6483\u306E{DamageMultiplier}\u304F\u3089\u3044\u306E\u5A01\u529B\uFF09\n\n\u30BF\u30FC\u30B2\u30C3\u30C8\u306B\u7684\u4E2D\u3057\u305F\u5F8C\u3001\u30D7\u30EC\u30A4\u30E4\u30FC\u3068\u6575\u3068\u306E\u534A\u76F4\u7DDA\u72B6\u306B\u3044\u308B\u6575\u306B\u5BFE\u3057\u3066\u30B9\u30AD\u30EB\u706B\u529B\u306E50\uFF05\u306E\u30C0\u30E1\u30FC\u30B8\u3092\u4E0E\u3048\u308B\u3002"
  _tips: "\u53CC\u5B50\u306E\u7247\u5272\u308C\u3067\u3042\u308B3\u53F7\u306F\u3001\u5DE6\u76EE\u3092\u5931\u3063\u305F\u4EE3\u511F\u306B\u5B8C\u5168\u8A18\u61B6\u80FD\u529B\u3092\u6301\u3063\u3066\u3044\u305F\u3002\r\nSymphony\u306B\u6F5C\u5165\u5DE5\u4F5C\u306E\u3044\u308D\u306F\u3092\u53E9\u304D\u8FBC\u3093\u3060\u5E2B\u5320\u3067\u3042\u308B\u5F7C\u5973\u306F\r\n\u92FC\u306E\u5FC3\u81D3\u3068\u8A00\u308F\u308C\u308B\u307B\u3069\u306B\u5C48\u5F37\u306E\u9762\u305F\u308B\u3092\u6301\u3061\u5408\u308F\u305B\u3066\u3044\u308B\u3002\r\n\u3057\u304B\u3057\u3001\u305D\u3093\u306A\u5F7C\u5973\u306E\u8DA3\u5473\u306F\u300E\u88C1\u7E2B\u300F\u3060\u3063\u305F\u3002\r\n\u3042\u308B\u8056\u591C\u3001\u5F7C\u5973\u306F\u5B9F\u8DF5\u8A13\u7DF4\u3068\u79F0\u3057Symphony\u3092\u9023\u308C\u3066\u4FB5\u5165\u30DF\u30C3\u30B7\u30E7\u30F3\u3092\u5B9F\u884C\u3057\u305F\u3002\r\n\u4F5C\u6226\u5185\u5BB9\u306F\u30013\u53F7\u304C\u7DE8\u3093\u3060\u30DE\u30D5\u30E9\u30FC\u3092\u5404ZeroDivide\u30E1\u30F3\u30D0\u30FC\u306E\u6795\u5143\u306B\u7F6E\u304F\u3068\u3044\u3046\u3082\u306E\u3002\r\n\u5B50\u4F9B\u3058\u307F\u305F\u4F5C\u6226\u3060\u304C\u3001\u305D\u306E\u96E3\u6613\u5EA6\u306F\u3069\u306E\u4EFB\u52D9\u3088\u308A\u3082\u9AD8\u3044\u3002\r\n\u6226\u95D8\u6280\u8853\u306B\u7279\u5316\u3057\u305F\u4EBA\u9020\u4EBA\u9593\u3067\u3042\u308B\u4EF2\u9593\u305F\u3061\r\n\u5F7C\u3089\u3092\u3092\u6B3A\u304F\u306E\u3060\u304B\u3089\u305D\u308C\u3082\u305D\u306E\u306F\u305A\u3060\u3063\u305F\u3002\r\n\u3057\u304B\u3057\u3001\u6F5C\u5165\u5DE5\u4F5C\u306B\u7279\u5316\u3057\u305F\u5F7C\u5973\u306B\u306F\u305D\u308C\u3082\u5BB9\u6613\u306A\u3053\u3068\u3060\u3063\u305F\u306E\u3060\u308D\u3046\u3002\r\n\u4EFB\u52D9\u3092\u96E3\u306A\u304F\u3053\u306A\u3057\u3066\u3044\u304D\u3001\u6C17\u3065\u3051\u3070\u6B8B\u308A\u306F\u4E00\u4EBA\r\n\u88AB\u691C\u4F531\u53F7\u3001Triad\u306E\u307F\u306B\u306A\u3063\u3066\u3044\u305F\u3002\r\n\u4E8C\u4EBA\u306F\u5F7C\u306E\u90E8\u5C4B\u3078\u3068\u6F5C\u5165