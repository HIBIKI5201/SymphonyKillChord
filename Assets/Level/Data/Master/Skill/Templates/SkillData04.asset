  _skillDetail: "5\u79D2\u9593\u3001\u653B\u6483\u3067\u4E0E\u3048\u305F\u30C0\u30E1\u30FC\u30B8\u306E30\uFF05\u306E\u904E\u5270HP\uFF08\u30D0\u30EA\u30A2\uFF09\u3092\u7372\u5F97\u3059\u308B\u3002\n\u30D0\u30D5\u3092\u7372\u5F97\u3057\u305F\u5F8C4\u62CD\u306E\u653B\u6483\u3092\u884C\u3046\u3002"
  _tips: "\u5F37\u8972\u6A5F\u52D5\u90E8\u968A\u5206\u968A\u9577\u3002\u305D\u308C\u304C\u5F7C\u5973\u306E\u80A9\u66F8\u3067\u3042\u3063\u305F\u3002\r\n\u6226\u95D8\u306E\u30B9\u30DA\u30B7\u30E3\u30EA\u30B9\u30C8\u3067\u3042\u308B\u5F7C\u5973\u3060\u304C\u3001\u305D\u306E\u5B9F\u614B\u306F\r\n\u5E38\u306B\u6C17\u3060\u308B\u3052\u3067\u3084\u308B\u6C17\u306E\u306A\u3044\u9152\u597D\u304D\u3002\r\nSymphony\u306E\u524D\u3067\u98F2\u3093\u3067\u3044\u305F\u6642\u306B\u3001\u5F7C\u5973\u306F\u53E3\u3092\u6ED1\u3089\u305B\u3066\r\n\u8AB0\u306B\u3082\u4F1D\u3048\u3066\u3044\u306A\u3044\u79D8\u5BC6\u3092\u5410\u9732\u3057\u3066\u3057\u307E\u3063\u305F\u3053\u3068\u304C\u3042\u308B\u3002\r\n0\u53F7\u3092\u5931\u3044\u3001\u4ED6\u8005\u3078\u306E\u7591\u5FF5\u304C\u9AD8\u307E\u3063\u305F\u5F7C\u5973\u306F\r\n\u8AB0\u304B\u306E\u305F\u3081\u306B\u751F\u304D\u308B\u3053\u3068\u306B\u75B2\u308C\u3066\u3057\u307E\u3063\u305F\u3002\r\n\u305D\u306E\u672B\u3001\u9078\u3093\u3060\u9078\u629E\u306F\u3001\u81EA\u6B7B\u3002\r\n\u305D\u306E\u8A00\u8449\u306E\u91CD\u307F\u306F\u3001\u9154\u3063\u6255\u3063\u3066\u3044\u305F\u5F7C\u5973\u306E\u53E3\u304B\u3089\u3082\u611F\u3058\u53D6\u308C\u308B\u307B\u3069\u3060\u3063\u305F\u305D\u3046\u3002\r\n\u3057\u304B\u3057\u3001Symphony\u306E\u5B58\u5728\u304C\u305D\u306E\u6C7A\u65AD\u3092\u59A8\u3052\u305F\u306E\u3060\u3002\r\n\u5F7C\u5973\u306E\u5B58\u5728\u304C\u5E0C\u671B\u3092\u4E0E\u3048\u3001\u4ECA\u3067\u3082\u751F\u304D\u308B\u5149\u3068\u306A\u3063\u3066\u3044\u308B\u3002\r\n\u305D\u308C\u306FSymphony\u30680\u53F7\u306E\u9762\u5F71\u304C\u540C\u3058\u305B\u3044\u3067\u3082\u3042\u308B\u306E\u304B\u3082\u3057\u308C\u306A\u3044\u3002\r\n
    \r\n\u300CSymphony\u3061\u3083\u3093\u306F\u3041\u79C1\u304C\u5B88\u308B\u304B\u3089\u306D\u30FC\u3002\u7D76\u5BFE\u306B\u3043\u6B7B\u306A\u305B\u306A\u3044\u304B\u3089\u30FC\u300D\r\n
