  _skillDetail: "\u901A\u5E38\u653B\u6483\u306E\u30B7\u30E7\u30C3\u30C8\u30AC\u30F3\u306E\u653B\u6483\u3092\u767A\u52D5\u3057\u3001\n\u305D\u306E\u653B\u6483\u306B\u5F53\u305F\u3063\u305F\u5BFE\u8C61\u306B\u88AB\u30C0\u30E1\u30FC\u30B8\u91CF25%\u5897\u52A0\u306E\u30C7\u30D0\u30D5\u30925\u79D2\u9593\u4ED8\u4E0E\u3059\u308B\u3002"
  _tips: "\u4EBA\u9020\u4EBA\u9593\u8A08\u753B\u306B\u3088\u3063\u3066\u9020\u3089\u308C\u305F\u4E09\u4F53\u76EE\u306E\u88AB\u691C\u4F53\u3067\u3042\u308A\u3001\u53CC\u5B50\u306E\u7247\u5272\u308C\u3002\r\n\u305D\u308C\u304C\u88AB\u691C\u4F532\u53F7\u3067\u3042\u3063\u305F\u3002\r\n\u53F3\u76EE\u306E\u8996\u529B\u304C\u306A\u304F\u96BB\u773C\u306E\u5F7C\u306F\u3001Symphony\u304C\u53C2\u52A0\u3057\u306A\u3044\u8ECD\u4E8B\u884C\u52D5\u306E\u6307\u63EE\u3092\u62C5\u5F53\u3057\u3066\u3044\u308B\u3002\r\n\u76F4\u63A5\u7684\u306A\u95A2\u308A\u306F\u3042\u307E\u308A\u306A\u3044\u3001\u305D\u306E\u306F\u305A\u3060\u3063\u305F\u306E\u3060\u304C\u3001\u5F7C\u306E\u304A\u7BC0\u4ECB\u713C\u306E\u6027\u683C\u304C\r\n\u672B\u3063\u5B50\u3067\u3042\u308B\u5F7C\u5973\u3068\u306E\u95A2\u4FC2\u3092\u6DF1\u3081\u3066\u3044\u305F\u3002\r\n2\u53F7\u306F\u7814\u7A76\u3067\u8996\u529B\u3092\u5931\u3063\u305F\u4EE3\u511F\u306B\u3001\u4ED6\u8005\u3092\u5206\u6790\u3059\u308B\u529B\u306B\u9577\u3051\u3066\u3044\u305F\u3002\r\n\u305D\u306E\u305F\u3081\u3001Symphony\u306E\u624B\u304C\u5668\u7528\u306A\u3053\u3068\u306B\u3044\u3061\u65E9\u304F\u6C17\u304C\u4ED8\u3044\u305F\u306E\u3060\u308D\u3046\u3002\r\n
    \r\n\u300C\u304A\u524D\u306F\u5DE6\u5229\u304D\u306A\u306E\u304B\u3002\u305D\u308C\u306A\u3089\u305D\u3061\u3089\u306B\u30CF\u30F3\u30C9\u30AC\u30F3\u3092\u6301\u3061\u3001\u53CD\u5BFE\u306B\u9577\u7269\u2026\u2026\r\n\u305D\u3046\u3060\u306A\u3001\u30E9\u30A4\u30D5\u30EB\u306A\u3093\u304B\u3092\u6301\u3063\u3066\u307F\u3066\u3082\u3044\u3044\u304B\u3082\u3057\u308C\u306A\u3044\u3002\r\n\u304A\u524D\u306F\u3001\u899A\u3048\u304C\u3044\u3044\u304B\u3089\u306A\u300D\r\n
    \r\n\u305D\u306E\u8A00\u8449\u304C\u3001\u5F7C\u5973\u306E\u5FC3\u306B\u3069\u3046\u97FF\u3044\u305F\u306E\u304B\u306F\u308F\u304B\u3089\u306A\u3044\u3002\r\n\u3057\u304B\u3057\u3001\u5F7C\u5973\u306E\u6226\u95D8\u30B9\u30BF\u30A4\u30EB\u304C\u4ECA\u3067\u3082\u540C\u3058\u306A\u306E\u306F\u305D\u308C\u304C\u4F53\u306B\u5408\u3063\u3066\u3044\u305F\u304B\u3089\u3060\u308D\u3046\u3002"
