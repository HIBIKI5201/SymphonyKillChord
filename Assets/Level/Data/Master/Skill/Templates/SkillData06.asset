  _skillDetail: "\u81EA\u8EAB\u306B\u5BFE\u3057\u3066n\u79D2\u9593\u3001\u300C\u30C0\u30E1\u30FC\u30B8\u3092\u4E0E\u3048\u308B\u3054\u3068\u306B\u305D\u306E\u30C0\u30E1\u30FC\u30B8\u306E10\uFF05\u306EHP\uFF08\u4E00\u767A\u306E\u56DE\u5FA9\u4E0A\u9650\uFF1A5\uFF09\u3092\u56DE\u5FA9\u3059\u308B\u300D\u30D0\u30D5\u3092\u4ED8\u4E0E\u3002"
  _tips: "\u5F7C\u5973\u306E\u77B3\u3092\u898B\u308B\u3053\u3068\u306F\u3001\u6697\u95C7\u3067\u3057\u304B\u304B\u306A\u308F\u306A\u3044\u3002\r\n\u5F7C\u5973\u306F\u3001\u5F37\u8972\u6A5F\u52D5\u968A\u306E\u30AC\u30F3\u30CA\u30FC\u3002\r\n\u6B63\u78BA\u304B\u3064\u51B7\u9177\u306B\u6253\u3061\u629C\u304F\u7CBE\u5BC6\u6027\u304C\u6B66\u5668\u3060\u3063\u305F\u3002\r\n\u51B7\u9759\u6C88\u7740\u3002\r\n\u305D\u306E\u8A00\u8449\u304C\u4E00\u756A\u4F3C\u5408\u3046\u5F7C\u5973\u304C\u8CA0\u3063\u305F\u4EE3\u511F\u306F\r\n\u5149\u3092\u53D6\u308A\u5165\u308C\u308B\u3053\u3068\u306E\u3067\u304D\u306A\u3044\u30E2\u30CE\u30AF\u30ED\u306E\u4E16\u754C\u3060\u3063\u305F\u3002\r\n\u4E21\u76EE\u3092\u5E2F\u3067\u8986\u3046\u5F7C\u5973\u306B\u3001Symphony\u306F\u3053\u3046\u544A\u3052\u305F\u3002\r\n
