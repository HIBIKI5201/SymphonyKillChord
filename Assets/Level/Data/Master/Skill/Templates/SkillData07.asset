  _skillDetail: "\u81EA\u8EAB\u306E\u524D\u65B960\u5EA6\uFF08\u4EEE\uFF09\u5C04\u7A0B12m\u5185\u306B\u3044\u308B\u6575\u306B\u5BFE\u3057\u30664\u62CD\u5B50\u306E\u901A\u5E38\u653B\u6483\u3092{HitCount}\u884C\u3046\u3002\n\n\u7BC4\u56F2\u5185\u306B\u6575\u304C3\u4F53\u4EE5\u4E0A\u3044\u305F\u5834\u5408\u3001\u4E00\u5EA6\u30B9\u30AD\u30EB\u52B9\u679C\u5185\u306E\u901A\u5E38\u653B\u6483\u3092\u53D7\u3051\u305F\u6575\u306F\u653B\u6483\u306E\u30BF\u30FC\u30B2\u30C3\u30C8\u306B\u306A\u3089\u306A\u3044\u3002\uFF08\u7BC4\u56F2\u5185\u306B\u6575\u304C3\u4F53\u3044\u305F\u5834\u5408\u306F\u6575\u5168\u54E1\u306B\u30B9\u30AD\u30EB\u304CHit\u3059\u308B\uFF09\n\n\u7BC4\u56F2\u5185\u306B\u6575\u304C2\u4F53\u4EE5\u4E0B\u306E\u5834\u5408\u3001\n\u901A\u5E38\u653B\u64832\u56DE\u76EE\u4EE5\u964D\u306E\u653B\u6483\u5BFE\u8C61\u9078\u629E\u6642\u306B\u7BC4\u56F2\u5185\u306E\u3059\u3079\u3066\u306E\u6575\u306B\u653B\u6483\u304C\u7684\u4E2D\u3057\u3066\u305F\u5834\u5408\u306F\u30BF\u30FC\u30B2\u30C3\u30C8\u5185\u306B\u3044\u308B\u6575\u306B\u6B8B\u308AHP\u304C\u9AD8\u3044\u9806\u3067\u901A\u5E38\u653B\u6483\u304C\u518D\u5EA6Hit\u3059\u308B\u3002\n\n\u901A\u5E38\u653B\u6483\u304CHit\u3057\u305F\u5BFE\u8C61\u306E\u6700\u5927\u653B\u6483\u529B10\uFF05\u3092\u6E1B\u5C11\u3055\u305B\u308B\u3002\n\uFF08\u52B9\u679C\u306E\u91CD\u8907\u53EF\u80FD\u3010\u6575\u4E00\u4F53\u306E\u4E0A\u9650\u6E1B\u5C11\u91CF\uFF1A10\u3011\uFF09\n\n\u305D\u306E\u5F8C\u3001\u81EA\u8EAB\u306E\u653B\u6483\u529B\u309210\u79D2\u9593\u3001\u6E1B\u5C11\u3057\u305F\u6575\u306E\u653B\u6483\u529B\u5206\u4E0A\u6607\u3055\u305B\u308B\u3002"
  _tips: "\u610F\u56FA\u5730\u306A\u73FE\u5834\u4E3B\u7FA9\u8005\u3002\r\n\u3057\u304B\u3057\u5F7C\u5973\u306E\u6226\u8853\u7ACB\u6848\u304C\u3060\u308C\u3088\u308A\u3082\u512A\u308C\u3066\u3044\u308B\u3053\u3068\u3082\u3001\u78BA\u304B\u3067\u3042\u3063\u305F\u3002\r\n\u5F37\u8972\u6A5F\u52D5\u968A\u30AC\u30F3\u30CA\u30FC\u3001\u30D6\u30EA\u30FC\u30C1\u30E3\u30FC\u3068\u3057\u3066\u306E\u5F79\u76EE\u3092\u62C5\u3046\u5F7C\u5973\u306F\r\n\u6226\u5834\u306B\u304A\u3044\u3066\u524D\u7DDA\u306B\u8EAB\u3092\u6295\u3058\u3066\u3044\u308B\u3002\r\n\u6226\u5834\u3057\u304B\u77E5\u3089\u306A\u3044\u5F7C\u5973\u306F\u3001\u5A2F\u697D\u3068\u3044\u3046\u3082\u306E\u306B\u3068\u3053\u3068\u3093\u758E\u304B\u3063\u305F\u3002\r\n\u4F55\u306E\u6C17\u306E\u8FF7\u3044\u304B\u3001\u5F7C\u5973\u304CSymphony\u306B\u30D4\u30A2\u30CE\u306E\u5F3E\u304D\u65B9\u3092\u6559\u308F\u308A\u306B\u884C\u3063\u305F\u3053\u3068\u304C\u3042\u3063\u305F\u3002\r\n\u304E\u3053\u3061\u306A\u3044\u6307\u5148\u306F\u3001\u3042\u308B\u5F7C\u5973\u306E\u8A00\u8449\u3092\u5883\u306B\u3001\u719F\u7DF4\u7D4C\u9A13\u8005\u9854\u8CA0\u3051\u306E\u901F\u5EA6\u3067\u8E0A\u308A\u59CB\u3081\u308B\u3002\r\n\u305D\u308C\u306B\u306FSymphony\u3082\u611F\u5606\u3092\u6F0F\u3089\u3059\u307B\u3069\u3060\u3063\u305F\u305D\u3046\u3002\r\n
    \r\n\u300C\u305D\u3046\u304B\u3001\u76E4\u4E0A\u306F\u6226\u5834\u3001\u3064\u307E\u308A\u3001\u4F55\u3089\u5909\u308F\u308A\u306A\u3044\u2026\u2026\u300D\r\n
    \r\n\u3057\u304B\u3057\u305D\u306E\u8A00\u8449\u306E\u610F\u5473\u306B\u3001Symphony\u306F\u305F\u3069\u308A\u7740\u3051\u306A\u304B\u3063\u305F\u3002"
