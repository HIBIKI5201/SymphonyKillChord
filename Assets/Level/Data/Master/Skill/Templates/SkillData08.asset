  _skillDetail: "3\u62CD\u5B50\u306E\u901A\u5E38\u653B\u6483\u3092\u884C\u3046\u3002\n\u305D\u306E\u901A\u5E38\u653B\u6483\u304C\u5F53\u305F\u3063\u305F\u6575\u3068\u305D\u306E\u6575\u306E\u534A\u5F84n\u30E1\u30FC\u30C8\u30EB\u4EE5\u5185\u306B\u3044\u308B\u6575\u306B\u5BFE\u3057\u3066\u4F1D\u67D3\u72B6\u614B\u3092\u4ED8\u4E0E\u3059\u308B\u3002\n\uFF08\u4F1D\u67D3\u56DE\u6570\u306Fs\u56DE\u3067\u52B9\u679C\u304C\u6D88\u6EC5\u3059\u308B\u3002\uFF09\n\n\u3010\u4F1D\u67D3\u72B6\u614B\u3011\n\u653B\u6483\u3092\u53D7\u3051\u305F\u3068\u304D\u3059\u3079\u3066\u306E\u4F1D\u67D3\u72B6\u614B\u306E\u6575\u306B\u5BFE\u3057\u3066\u3001\u653B\u6483\u3092\u53D7\u3051\u305F\u6575\u306E\u88AB\u30C0\u30E1\u30FC\u30B8\u306En\uFF05\u306E\u30C0\u30E1\u30FC\u30B8\u3092\u4E0E\u3048\u308B\u3002\n\u4ED6\u306E\u4F1D\u67D3\u72B6\u614B\u306E\u6575\u306B\u4E0E\u3048\u305F\u3068\u304D\u306E\u30C0\u30E1\u30FC\u30B8\u5224\u5B9A\u306F\u901A\u5E38\u653B\u6483\u3092\u53D7\u3051\u305F\u3068\u304D\u3068\u540C\u3058\u3082\u306E\u3092\u884C\u3046\u3002\n\uFF08\u30AF\u30EA\u30C6\u30A3\u30AB\u30EB\u5224\u5B9A\u3084\u30B8\u30E3\u30B9\u30C8\u5224\u5B9A\u3082\u884C\u3044\u3001\u305D\u306E\u500D\u7387\u3082\u304B\u304B\u308B\uFF09"
  _tips: "\u88AB\u691C\u4F53\uFF18\u53F7\u3002\u5F7C\u306F\u7814\u7A76\u6240\u5185\u3067\u5931\u6557\u4F5C\u306E\u30EC\u30C3\u30C6\u30EB\u3092\u5F35\u3089\u308C\u305F\u4EBA\u9020\u4EBA\u9593\u306E\u4E00\u4EBA\u3067\u3042\u3063\u305F\u3002\r\n\u540C\u6642\u306B\u4E00\u3064\u306E\u4E8B\u3057\u304B\u3067\u304D\u305A\u3001\u3059\u3050\u306B\u30DF\u30B9\u3092\u3059\u308B\u5F7C\u3092\r\n\u7D66\u990C\u3068\u3057\u3066\u50CD\u304B\u305B\u305F\u7814\u7A76\u8005\u305F\u3061\u306E\u5224\u65AD\u306F\u679C\u305F\u3057\u3066\u6B63\u3057\u304B\u3063\u305F\u306E\u304B\u3002\r\n\u7814\u7A76\u65BD\u8A2D\u6B66\u88C5\u8702\u8D77\u3002\r\n\u305D\u306E\u969B\u306B\u4E00\u5F79\u8CB7\u3063\u305F\u306E\u304C\u5F7C\u3060\u3063\u305F\u3053\u3068\u3092\u3001\u7814\u7A76\u8005\u305F\u3061\u304C\u77E5\u308B\u3053\u3068\u306F\u306A\u3044\u3060\u308D\u3046\u3002\r\n\u305D\u3093\u306A\u5F7C\u3082\u4ECA\u3067\u306F\u5F37\u8972\u6A5F\u52D5\u968A\u306E\u885B\u751F\u5175\u3068\u3044\u3046\u5F79\u8077\u3092\u8A87\u308A\u306B\u601D\u3063\u3066\u3044\u308B\u3002\r\nSymphony\u306E\u624B\u5F53\u3092\u3057\u3066\u3044\u308B\u969B\u3001\u5F7C\u306F\u3053\u3093\u306A\u3053\u3068\u3092\u3053\u307C\u3057\u305F\u3068\u3044\u3046\u3002\r\n
    \r\n\u300C\u307F\u3093\u306A\u304C\u3042\u306A\u305F\u3092\u5B88\u308B\u306A\u3089\u3001\u50D5\u306F\u3042\u306A\u305F\u306E\u50B7\u3092\u6CBB\u3057\u307E\u3059\u3002Symphony\u306F\u50D5\u305F\u3061\u306E\u672B\u3063\u5B50\u3067\u3059\u304B\u3089\u306D\u300D\r\n
    \r\n\u305D\u3046\u7B11\u3046\u5F7C\u3053\u305D\u3001\u90E8\u968A\u5168\u54E1\u306B\u5F1F\u3068\u3057\u3066\u6271\u308F\u308C\u3066\u3044\u308B\u306E\u3060\u3068\r\n\u5FDC\u6025\u51E6\u7F6E\u3092\u3057\u3066\u3082\u3089\u3063\u3066\u3044\u308B\u5F7C\u5973\u306F\u3001\u4F0F\u3057\u76EE\u304C\u3061\u306B\u53E3\u306B\u3057\u305F\u3089\u3057\u3044\u3002"
