%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ba16f9e1a1dd9a241ab8973f2db67eb9, type: 3}
  m_Name: LoadingTipsConfig
  m_EditorClassIdentifier: KillChord.View::KillChord.Runtime.View.Persistent.Load.LoadingTipsConfig
  tips:
  - _title: "人造人間計画について 1"
    _body: "『人造人間計画』。1967～1989年まで実施されていた強化人間製造策。0号をはじめ多くの被検体が生み出され、計画は量産型の製造着手にまで至っていた。"
  - _title: "人造人間計画について 2"
    _body: "しかし研究所が連邦の崩壊危機により閉鎖し、計画は頓挫、被検体はすべて処分と決定し、連邦は計画を失敗として決着させた。"
  - _title: "ZeroDivideについて 1"
    _body: "『民間軍事会社ZeroDivide』。被検体１号Triadによって設立され、そのメンバーは『人造人間計画』の被検体13人で構成された傭兵集団。"
  - _title: "ZeroDivideについて 2"
    _body: "彼らの目的は『秘密組織カペリメイステル』への復讐及び壊滅、そして、自分らを人間と認めさせることであった。"
  - _title: "カペリメイステルについて 1"
    _body: "『秘密結社カペリメイステル』。連邦政府の一部の高官、そしてかつての『人造人間計画』、その研究者で構成され『指揮者計画』の再現を企む秘密結社財団組織。"
  - _title: "カペリメイステルについて 2"
    _body: "計画復活のため、かつての被検体の捕獲を企んでいるが、未だにそれは成しえていない。"
  - _title: "0号について 1"
    _body: "実験中の事故により息を引き取ってしまった被検体0号は、『人造人間計画』によって生み出された最初の被検体であり、その後に生み出される人造人間の始祖に当たる存在だった。"
  - _title: "0号について 2"
    _body: "彼女は他の被検体たちからとても敬愛、信頼、尊敬、そのすべての念を向けられていた。亡き今もなお、それは変わらず、彼女は慕われ続けている。"
  - _title: "13号について 1"
    _body: "被検体0号が死亡し、研究の衰退を危惧した研究者は、彼女の肉体的クローンを製造することを決定した。"
  - _title: "13号について 2"
    _body: "そして造られたのが製造ナンバー『被検体13号』。Symphonyであった。"
  - _title: "孤児院について 1"
    _body: "ネべリスク近郊に、かつて孤児院があった。しかし、奏でられるピアノの音色、寮母と共に仲睦ましく暮らす子供たちの姿はもう、そこにはない。"
  - _title: "孤児院について 2"
    _body: "あるのはただ、瓦礫の散らばる広い敷地に、それを眺める機械少女の背中が小さく映るだけだった。"
  - _title: "研究所蜂起について 1"
    _body: "研究所閉鎖の前日、処分される予定であった被検体たちが、一斉に武装蜂起をした。"
  - _title: "研究所蜂起について 2"
    _body: "彼らは研究所内に立てこもり、脱出したのち、『民間軍事会社ZeroDivide』を設立する。"
  - _title: "バイクについて 1"
    _body: "SymphonyはZeroDivide加入後、彼女の相棒とも呼べるそれと共に、戦地へと駆け抜けていく。彼女の幼い見た目とかけ離れた機動二輪、IZ-49。"
  - _title: "バイクについて 2"
    _body: "その轟音鳴るエンジンに跨り、今も彼女はその荒れた戦地を疾駆の勢いで奔り抜けていた。"
  - _title: "指揮者計画について 1"
    _body: "『指揮者計画』。1962年、連邦政府により立案された、核戦争による汚染環境での作戦展開を可能にする兵士の開発計画。"
  - _title: "指揮者計画について 2"
    _body: "しかしそれが実現することはなく頓挫した。しかし現在、『秘密結社カペリメイステル』によってその計画は再始動している。"
