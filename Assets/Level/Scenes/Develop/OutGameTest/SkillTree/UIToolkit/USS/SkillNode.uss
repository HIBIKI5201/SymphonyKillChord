.skill-node {
    background-color: rgb(255, 255, 255);
}

.skill-node-node {
    width: 75px;
    height: 75px;
    border-radius: 5px;
    border-width: 3px;
}

.skill-node-path {
    width: 50px;
    height: 50px;
    border-radius: 3px;
    border-width: 2px;
}

.skill-node-locked {
    opacity: 0.5;
}

.skill-node-unlocked {
    opacity: 1;
}

.skill-node-selected {
    border-color: rgb(227, 212, 0);
}

.skill-node-not-selected {
    border-color: rgb(64, 64, 64);
}

.skill-node-font {
    -unity-font-style: bold;
}
