:root {
}

.skilltree-top-bar {
    position: absolute;
    left: 0;
    top: 0;
    flex-direction: row;
    align-items: center;
    background-color: rgb(18, 33, 61);
    border-bottom-right-radius: 0;
    padding: 14px 32px 14px 20px;
}

.skilltree-top-bar-title {
    color: rgb(255, 255, 255);
    font-size: 30px;
    -unity-font-style: bold;
    margin-right: 20px;
}

.skilltree-top-bar-points {
    color: rgb(207, 214, 230);
    font-size: 20px;
    -unity-font-style: bold;
}

.skilltree-reset-button {
    position: absolute;
    right: 16px;
    bottom: 16px;
    width: 220px;
    height: 56px;
    background-color: rgb(238, 240, 228);
    color: rgb(26, 26, 26);
    font-size: 22px;
    -unity-font-style: bold;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
}

.skilltree-panel {
    flex-direction: column;
    background-color: rgb(17, 29, 51);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(58, 84, 135);
    border-right-color: rgb(58, 84, 135);
    border-top-color: rgb(58, 84, 135);
    border-bottom-color: rgb(58, 84, 135);
}

.skilltree-panel-header-bar {
    flex-shrink: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Arts/Images/Sprites/UI/OutGame/UI_Reserch_NameTab.png?fileID=21300000&guid=16997e8e901f4164e9f0abf42a763d2b&type=3#UI_Reserch_NameTab");
    -unity-background-scale-mode: stretch-to-fill;
    color: rgb(255, 255, 255);
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    padding: 14px 20px;
}

.skilltree-panel-body {
    flex-direction: column;
    background-image: url("project://database/Assets/Arts/Images/Sprites/UI/OutGame/UI_OptionMenu_Back.png?fileID=21300000&guid=bc61cc40ebe776f47ad55951da4d527e&type=3#UI_OptionMenu_Back");
    -unity-background-scale-mode: stretch-to-fill;
    padding: 18px 20px;
}

.skilltree-status-row {
    flex-direction: row;
    align-items: center;
    background-image: url("project://database/Assets/Arts/Images/Sprites/UI/OutGame/UI_Status_Back.png?fileID=21300000&guid=6ad5873f2bf323c43b7200b9b7fca4d5&type=3#UI_Status_Back");
    -unity-background-scale-mode: stretch-to-fill;
    padding: 4px 8px;
    margin-bottom: 10px;
}

.skilltree-status-icon {
    width: 34px;
    height: 34px;
    margin-right: 12px;
    -unity-background-scale-mode: scale-to-fit;
}

.skilltree-status-label {
    color: rgb(207, 214, 230);
    font-size: 24px;
    flex-grow: 1;
}

.skilltree-status-current-value {
    color: rgb(255, 255, 255);
    font-size: 24px;
    width: 90px;
    -unity-text-align: middle-right;
}

.skilltree-status-delta-value {
    color: rgb(255, 255, 255);
    font-size: 24px;
    width: 130px;
    margin-left: 6px;
    margin-right: -10px;
    -unity-text-align: middle-left;
}

.skilltree-info-top {
    flex-direction: row;
    align-items: center;
    margin-bottom: 14px;
}

.skilltree-info-icon {
    width: 84px;
    height: 84px;
    min-width: 84px;
    min-height: 84px;
    background-color: rgb(0, 0, 0);
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-right-radius: 50%;
    border-bottom-left-radius: 50%;
    -unity-background-scale-mode: scale-to-fit;
    margin-right: 16px;
}

.skilltree-info-name {
    color: rgb(255, 255, 255);
    font-size: 28px;
    -unity-font-style: bold;
    white-space: normal;
}

.skilltree-combo-row {
    flex-direction: row;
    margin-top: 6px;
}

.skilltree-combo-hex {
    width: 30px;
    height: 30px;
    margin-right: 10px;
}

.skilltree-info-cost-row {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 8px;
    margin-bottom: 8px;
}

.skilltree-info-cost-label {
    color: rgb(207, 214, 230);
    font-size: 20px;
}

.skilltree-info-action-button {
    background-color: rgb(238, 240, 228);
    color: rgb(26, 26, 26);
    font-size: 20px;
    -unity-font-style: bold;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    margin-bottom: 10px;
}
