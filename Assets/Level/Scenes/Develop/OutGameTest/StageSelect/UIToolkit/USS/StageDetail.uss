:root {
}

.mission-check {
    width: 28px;
    height: 28px;
    min-width: 28px;
    border-color: rgb(120, 120, 120);
    border-radius: 20%;
    margin-right: 3%;
    flex-shrink: 0;
    top: 50%;
    left: 10px;
    translate: 0 -50%;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
}

/* 達成時のチェックマーク。未達成時は非表示にしておき、達成時のみ表示する。 */
.mission-check-mark {
    display: none;
    width: 100%;
    height: 100%;
    -unity-text-align: middle-center;
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(230, 180, 0);
}

.mission-check-mission-achieved .mission-check-mark {
    display: flex;
}

/* 装備中スキルのアイコン。空スロットはコードから display:none にする。 */
.equipped-skill-icon {
    width: 50px;
    height: 50px;
    margin-right: 8px;
    background-color: rgb(255, 255, 255);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    -unity-background-scale-mode: scale-to-fit;
}

/*
    出撃 / 閉じるボタン。
    枠線色は UXML のインライン指定から移設した。
    インラインスタイルは USS より優先されるため、そのままでは
    OutGameNavigation.uss のフォーカスリングが上書きされて見えなかった。
*/
.stage-detail-button {
    border-left-color: rgba(149, 149, 149, 0);
    border-right-color: rgba(149, 149, 149, 0);
    border-top-color: rgba(149, 149, 149, 0);
    border-bottom-color: rgba(149, 149, 149, 0);
    scale: 1 1;
    transition-property: scale, border-color;
    transition-duration: 0.1s;
    transition-timing-function: ease-out-circ;
}

.stage-detail-button:hover,
.stage-detail-button:focus {
    scale: 1.2 1.2;
}

.stage-detail-button:active {
    scale: 0.9 0.9;
}
