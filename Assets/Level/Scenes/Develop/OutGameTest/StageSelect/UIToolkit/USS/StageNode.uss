.stage-map {
    flex-grow: 1;
}

.stage-map__main-row {
    position: relative;
    flex-shrink: 0;
}

.stage-connection {
    background-color: rgb(102, 102, 102);
}

.stage-connection__fill {
    position: absolute;
    left: 0;
    top: 0;
    width: 0%;
    height: 100%;
    background-color: rgb(0, 0, 0);
    transition-property: width;
    transition-duration: 1s;
    transition-timing-function: ease-out;
}

.stage-node {
    width: 100px;
    height: 100px;
    border-radius: 50px;
    border-width: 12px;
    border-color: rgb(0, 0, 0);
    background-color: rgb(255, 255, 255);
    align-items: center;
    justify-content: center;
    padding: 0;
    margin: 0;
}

.stage-node--stage {
    border-color: rgb(0, 0, 0);
}

.stage-node--boss {
    border-color: rgb(0, 0, 0);
}

.stage-node__label {
    font-size: 20px;
    color: rgb(0, 0, 0);
    -unity-text-align: middle-center;
    -unity-font-style: normal;
    margin: 0;
    padding: 0;
    white-space: normal;
}

.stage-node--cleared {
    border-left-color: rgba(0, 255, 127, 0);
    border-right-color: rgba(0, 255, 127, 0);
    border-top-color: rgba(0, 255, 127, 0);
    border-bottom-color: rgba(0, 255, 127, 0);
}

.stage-node {
    scale: 1 1;
    transition-property: scale;
    transition-duration: 0.1s;
    transition-timing-function: ease-out-circ;
    background-image: none;
}

.stage-node:hover,
.stage-node:focus {
    scale: 1.2 1.2;
    background-image: url("project://database/Assets/drive-download-20260903T081243Z-1-001/UI_StageSelect_Flame.png?fileID=2800000&guid=9e77a7c740b359a4c9ffbfc6142b0821&type=3#UI_StageSelect_Flame");
}

.stage-node:active {
    scale: 0.9 0.9;
    background-image: url("project://database/Assets/drive-download-20260903T081243Z-1-001/UI_StageSelect_Flame.png?fileID=2800000&guid=9e77a7c740b359a4c9ffbfc6142b0821&type=3#UI_StageSelect_Flame");
}
