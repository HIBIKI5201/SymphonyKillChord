                <ui:Label text="Label" name="SubMissionLabel2" style="position: relative; -unity-text-align: middle-left; width: 100%; height: 100%; font-size: 22px; -unity-font-style: bold; align-self: flex-start; white-space: pre; left: auto; top: auto; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 46px;"/>
                <ui:VisualElement name="MissionCheck" class="mission-check" style="flex-grow: 1; position: absolute; background-color: rgb(255, 255, 255);">
