            <ui:Label text="クリア報酬" name="StageReward" style="position: relative; -unity-text-align: middle-left; width: 100%; height: 40px; font-size: 24px; -unity-font-style: normal; background-color: rgb(46, 53, 77); border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; left: auto; right: auto; aspect-ratio: auto; margin-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; padding-left: 10px; padding-right: 10px; padding-top: 10px; padding-bottom: 10px; color: rgb(255, 255, 255);"/>
            <ui:Label text="Label" name="RewardSkillBuildLabel" style="position: relative; -unity-text-align: middle-left; width: 100%; height: 25%; font-size: 22px; -unity-font-style: bold; align-self: flex-start; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;"/>
            <ui:Label text="Label" name="RewardSkillUnlockLabel" style="position: relative; -unity-text-align: middle-left; width: 100%; height: 25%; font-size: 22px; -unity-font-style: bold; align-self: flex-start; white-space: pre; left: auto; top: auto; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;"/>
        </ui:VisualElement>
        <ui:VisualElement name="MissionSection" style="flex-grow: 1; width: 460px; height: 0%; position: relative; align-self: center; background-size: 100% 100%; margin-left: 0; margin-right: 0;">
            <ui:VisualElement name="SubMission1Root" style="flex-grow: 0; width: 100%; height: 48px; margin-bottom: 24px; background-color: rgb(255, 255, 255); border-top-width: 1px; border-left-width: 1px; border-right-width: 1px; border-top-color: rgb(221, 221, 221); border-left-color: rgb(221, 221, 221); border-right-color: rgb(221, 221, 221); border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; border-bottom-width: 3px; border-bottom-color: rgb(130, 130, 130);">
                <ui:Label text="Label" name="SubMissionLabel1" style="position: relative; -unity-text-align: middle-left; width: 100%; height: 100%; font-size: 22px; -unity-font-style: bold; align-self: flex-start; white-space: pre; left: auto; top: auto; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 46px;"/>
