:root {
}

/* 全画面の開始領域は決定操作のフォーカスを維持し、選択枠だけを表示しない。 */
#TouchArea.navigable:focus {
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.button {
    width: 8%;
    aspect-ratio: 1;
    left: 3%;
    top: 4%;
    scale: 1 1;
    color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0);
    --unity-focus-outline-color: rgba(0, 0, 0, 0);
    transition-property: scale, color;
    transition-duration: 0.1s;
    transition-timing-function: ease-out-circ;
}
.button:hover,
.button:focus {
    background-color: rgba(0, 0, 0, 0.4);
}

#OptionButton:hover,
#OptionButton:focus {
    background-color: rgba(0, 0, 0, 0.4);
}

.button:active {
    scale: 0.9 0.9;
}


.titleLabel {
    -unity-font-style: bold;
    font-size: 84px;
    -unity-text-align: middle-left;
    color: rgb(253, 253, 253);
}

/* 操作案内の文字とボタン画像を一緒に点滅させる。入力は背面のTouchAreaへ通す。 */
.title-start-instruction {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 8%;
    width: 100%;
    align-items: center;
    justify-content: center;
    font-size: 72px;
    color: rgb(255, 255, 255);
}

.title-controller-instruction {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.title-start-text {
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
}

.title-start-button-icon {
    width: 72px;
    height: 72px;
    margin-left: 18px;
    margin-right: 18px;
    flex-shrink: 0;
}
