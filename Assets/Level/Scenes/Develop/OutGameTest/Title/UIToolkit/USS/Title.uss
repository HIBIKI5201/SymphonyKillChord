:root {
}

.button {
    width: 8%;
    aspect-ratio: 1;
    left: 3%;
    top: 4%;
    scale: 1 1;
    color: rgb(255, 255, 255);
    transition-property: scale, color;
    transition-duration: 0.1s;
    transition-timing-function: ease-out-circ;
}
.button:hover,
.button:focus {
    color: rgb(140, 140, 140);
    box-shadow: 0 0 16px 4px rgba(0, 0, 0, 0.6);
    -unity-background-image-tint-color: rgb(120, 120, 120);
}

.button:active {
    scale: 0.9 0.9;
}


.titleLabel {
    -unity-font-style: bold;
    font-size: 84px;
    -unity-text-align: middle-left;
    color: rgb(253, 253, 253);
}
