:root {
}

/* 全画面の開始領域は決定操作のフォーカスを維持し、選択枠だけを表示しない。 */
#TouchArea.navigable:focus {
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.button {
    width: 8%;
    aspect-ratio: 1;
    left: 3%;
    top: 4%;
    scale: 1 1;
    color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0);
    --unity-focus-outline-color: rgba(0, 0, 0, 0);
    transition-property: scale, color;
    transition-duration: 0.1s;
    transition-timing-function: ease-out-circ;
}
.button:hover,
.button:focus {
    background-color: rgba(0, 0, 0, 0.4);
}

#OptionButton:hover,
#OptionButton:focus {
    background-color: rgba(0, 0, 0, 0.4);
}

.button:active {
    scale: 0.9 0.9;
}


.titleLabel {
    -unity-font-style: bold;
    font-size: 84px;
    -unity-text-align: middle-left;
    color: rgb(253, 253, 253);
}
