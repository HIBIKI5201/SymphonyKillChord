<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="Slider" src="project://database/Assets/Level/Scenes/Develop/OutGameTest/Settings/UI%20Tool%20kit/Slider.uxml?fileID=9197481963319205126&amp;guid=40a390bd332bec940bf22ab696e311fd&amp;type=3#Slider"/>
    <Style src="project://database/Assets/Level/Scenes/Develop/OutGameTest/Title/UIToolkit/USS/Option.uss?fileID=7433441132597879392&amp;guid=a72d4d74f09284c488b35de6f07827a6&amp;type=3#Option"/>
    <Style src="project://database/Assets/Level/Scenes/Develop/OutGameTest/ScreenTransitionTest/UI%20Toolkit/Uss/Button.uss?fileID=7433441132597879392&amp;guid=1e78d0c0c6f33384896221d772a80442&amp;type=3#Button"/>
    <Style src="project://database/Assets/Level/Scenes/Develop/OutGameTest/ScreenTransitionTest/UI%20Toolkit/Uss/TopBar.uss?fileID=7433441132597879392&amp;guid=bb5c6f023ae9b494f9e906f04015c185&amp;type=3#TopBar"/>
    <ui:VisualElement name="BackGround" style="flex-grow: 1; justify-content: center;">
        <ui:VisualElement name="Root" class="tab-root" style="background-color: rgb(123, 123, 123);">
            <ui:TabView class="tab-view">
                <ui:Tab label="音量調節" name="VolumeControl">
                    <ui:VisualElement name="BackGround" style="width: 100%; height: 100%; flex-grow: 1; position: relative; background-color: rgb(255, 255, 255);">
                        <ui:Instance template="Slider" name="BGMVolumeSlider" class="audio-volume-slider"/>
                        <ui:Instance template="Slider" name="SEVolumeSlider" class="audio-volume-slider"/>
                    </ui:VisualElement>
                </ui:Tab>
                <ui:Tab label="データリセット" name="DetaReset">
                    <ui:VisualElement name="BackGround" style="width: 100%; height: 100%; flex-grow: 1; position: relative; background-color: rgb(113, 113, 113);"/>
                </ui:Tab>
            </ui:TabView>
            <ui:Button text="戻る" name="BackButton" class="back-button button" style="position: absolute; background-color: rgb(188, 188, 188); left: auto; right: 1%;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
