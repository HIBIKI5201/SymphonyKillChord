<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xmlns:screen="KillChord.Runtime.View.OutGame.Screen" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="SkillBuildDialog" src="project://database/Assets/Level/Scenes/Develop/OutGameTest/SkillBuild/UIToolkit/SkillBuildDialog.uxml?fileID=9197481963319205126&amp;guid=00db7cb3a885b6d49b5fb1be611db438&amp;type=3#SkillBuildDialog"/>
    <Style src="project://database/Assets/Level/Scenes/Develop/OutGameTest/ScreenTransitionTest/UI%20Toolkit/Uss/OutGameScreen.uss?fileID=7433441132597879392&amp;guid=2873ded5d140af5419fca59e2bf1d22c&amp;type=3#OutGameScreen"/>
    <Style src="project://database/Assets/Level/Scenes/Develop/OutGameTest/ScreenTransitionTest/UI%20Toolkit/Uss/Button.uss?fileID=7433441132597879392&amp;guid=1e78d0c0c6f33384896221d772a80442&amp;type=3#Button"/>
    <Style src="project://database/Assets/Level/Scenes/Develop/OutGameTest/ScreenTransitionTest/UI%20Toolkit/Uss/TopBar.uss?fileID=7433441132597879392&amp;guid=bb5c6f023ae9b494f9e906f04015c185&amp;type=3#TopBar"/>
    <Style src="project://database/Assets/Level/Scenes/Develop/OutGameTest/SkillBuild/UIToolkit/USS/SkillBuildScreen.uss?fileID=7433441132597879392&amp;guid=331b07cb4bd6d6e4ca7e207e4b09fa7c&amp;type=3#SkillBuildScreen"/>
    <ui:VisualElement name="SkillBuildRoot" class="skillbuild-root" style="width: 100%; height: 100%; align-items: stretch; align-content: auto; justify-content: flex-start;">
        <ui:VisualElement name="BackgroundImage" picking-mode="Ignore" style="position: absolute; left: 0; top: 0; width: 100%; height: 100%; background-image: url(&quot;project://database/Assets/Arts/Images/Sprites/BackGround_Home_Blur.png?fileID=21300000&amp;guid=dc434a71b6c90494e80f63bac4fd68b5&amp;type=3#BackGround_Home_Blur&quot;); -unity-background-scale-mode: scale-and-crop;"/>
        <ui:VisualElement name="TopBarAnchor" picking-mode="Ignore" style="position: relative; width: 0; height: 0; margin-left: -16px; margin-top: -16px;">
            <ui:VisualElement name="TopBarBackground" picking-mode="Ignore" style="position: absolute; left: 8px; top: 0; width: 769px; height: 131px; background-image: url(&quot;project://database/Assets/Arts/Images/Sprites/UI/OutGame/UI_OutGame_SceneTab.png?fileID=21300000&amp;guid=96c8d94dd68b3104fa34a3f388529d63&amp;type=3#UI_OutGame_SceneTab&quot;); -unity-background-scale-mode: stretch-to-fill;"/>
            <screen:AlphaHitTestButton name="BackButton" class="button back-button ui-se-cancel"/>
            <ui:Button name="SettingShortcutButton" class="button setting-shortcut-button ui-se-window" style="background-image: url(&quot;project://database/Assets/Arts/Images/Sprites/UI/WIP/UI_btn_square.png?fileID=21300000&amp;guid=37fd6d3204bfe514cb8207d301aa86af&amp;type=3#UI_btn_square&quot;);">
                <ui:Image name="SettingIconGlyph" picking-mode="Ignore" class="home-option-icon-glyph" style="background-image: url(&quot;project://database/Assets/Arts/Images/Sprites/UI/Home/UI_OptionIocn.png?fileID=21300000&amp;guid=bd80c72ceb0921245907a0bb0ceb0cc1&amp;type=3#UI_OptionIocn&quot;);"/>
            </ui:Button>
            <ui:Label text="改造" name="Title" enable-rich-text="true" class="title" style="height: 79px; width: 182px; -unity-font-style: bold; font-size: 30px; -unity-text-align: middle-left; color: rgb(255, 255, 255); position: absolute; left: 309px; top: 35px; translate: 0 0;"/>
            <ui:VisualElement name="PointsRow" class="skillbuild-header-points" style="position: absolute; left: 505px; top: 43px; height: 64px; width: 248px; flex-direction: column; align-items: flex-start;">
                <ui:Label name="PointsHeading" text="改造P：" class="skillbuild-header-points-heading" style="font-size: 24px;"/>
                <ui:Label text="0" name="OwnedPointsLabel" class="skillbuild-header-points-value" style="font-size: 24px;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="BodyRow" class="skillbuild-body-row" style="justify-content: flex-end; margin-right: 75px;">
            <ui:VisualElement name="SkillDetail" class="skillbuild-panel" style="width: 770px; justify-content: flex-start; align-items: stretch; height: 826px; margin-right: 5px;">
                <ui:Label name="DetailsHeading" text="詳細" class="skillbuild-panel-title" style="height: 58px; width: 220px; font-size: 40px;"/>
                <ui:VisualElement name="DetailContent" class="skillbuild-detail-content">
                    <ui:VisualElement name="Top" class="skill-detail-top">
                        <ui:Image name="skill-detail-icon" class="skill-detail-icon"/>
                        <ui:VisualElement class="skill-detail-heading">
                            <ui:Label name="skill-name-label" text="スキルを選択してください" class="skill-name-label" style="width: 254px; font-size: 45px;"/>
                            <ui:Label name="skill-combo-label" class="skill-combo-label" style="display: none;"/>
                            <ui:VisualElement name="ComboRow" class="skillbuild-combo-row" style="height: 26px;"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="SkillTypeBox" class="skillbuild-type-box" style="height: 184px; width: 179px; background-color: rgba(173, 173, 173, 0.2);">
                            <ui:Image name="skill-type-icon" class="skillbuild-type-icon"/>
                            <ui:Label name="SkillTypeHeading" text="スキルタイプ" class="skillbuild-type-caption" style="font-size: 24px;"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:ScrollView name="SkillDescription" vertical-scroller-visibility="Hidden" class="skill-description" style="height: 222px;">
                        <ui:Label name="SkillEffectHeading" text="スキル効果" class="skill-effect-heading" style="font-size: 30px;"/>
                        <ui:Label name="skill-description-label" class="skill-description-label" style="height: 119px; font-size: 24px;"/>
                        <ui:Label name="skill-tips-heading" text="Tips" class="skill-tips-heading" style="font-size: 30px;"/>
                        <ui:Label name="skill-tips-label" class="skill-tips-label" style="font-size: 24px;"/>
                    </ui:ScrollView>
                    <ui:VisualElement name="LevelPointRow" class="skillbuild-level-point-row" style="height: 75px;">
                        <ui:VisualElement name="LevelRow" class="skillbuild-info-row skillbuild-info-row-half skillbuild-info-row-left" style="height: 84px;">
                            <ui:Label name="LevelHeading" text="レベル" class="skillbuild-info-row-heading" style="font-size: 30px;"/>
                            <ui:Label text="" name="skill-level-label" class="skillbuild-info-row-value" style="font-size: 30px;"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="PointRow" class="skillbuild-info-row skillbuild-info-row-half" style="height: 84px;">
                            <ui:Label name="ModPointsHeading" text="改造P" class="skillbuild-info-row-heading" style="font-size: 30px;"/>
                            <ui:Label text="" name="skill-levelup-point-label" class="skillbuild-info-row-value" style="font-size: 30px;"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="skillbuild-panel-button-row" style="align-self: auto; justify-content: center; align-items: stretch; align-content: auto; margin-bottom: 14px;">
                        <ui:Button text="Level UP" name="SkillLevelUpButton" class="button ui-se-select skillbuild-action-button skillbuild-reinforce-button" style="background-image: url(&quot;project://database/Assets/Arts/Images/Sprites/UI/OutGame/UI_SkillUpgrade_Button.png?fileID=21300000&amp;guid=0d9c8ebcd7d2a8c4183f0bba71ba1efe&amp;type=3#UI_SkillUpgrade_Button&quot;); width: 432px; -unity-background-scale-mode: scale-to-fit; height: 166px; color: rgb(255, 255, 255); font-size: 40px; -unity-text-align: middle-left; word-spacing: 40px; padding-left: 82px;"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="FormationColumn" class="skillbuild-formation-column" style="height: 827px; margin-left: 5px;">
                <ui:VisualElement name="Formation" class="skillbuild-panel skillbuild-panel-nested" style="height: 508px; align-items: stretch; margin-bottom: 5px;">
                    <ui:Label name="FormationHeading" text="編成" class="skillbuild-panel-title" style="width: 228px; height: 61px; font-size: 40px;"/>
                    <ui:VisualElement name="SkillElementContainer" class="skill-element-container skillbuild-slot-row" style="height: 252px;">
                        <ui:VisualElement name="SkillSlot1" class="skill-element-slot skillbuild-slot" style="display: flex; height: 250px; width: 250px;">
                            <ui:VisualElement name="IconArea" class="skillbuild-slot-icon-area">
                                <ui:Image name="skill-slot-icon" class="skill-slot-icon" style="display: none;"/>
                                <ui:Label name="skill-slot-name" class="skill-slot-name"/>
                                <ui:Label text="＋" name="skill-slot-placeholder" class="skill-slot-placeholder" style="font-size: 100px;"/>
                            </ui:VisualElement>
                            <ui:VisualElement name="ComboRow" class="skillbuild-slot-combo-row"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="SkillSlot2" class="skill-element-slot skillbuild-slot" style="display: flex; height: 250px; width: 250px;">
                            <ui:VisualElement name="IconArea" class="skillbuild-slot-icon-area">
                                <ui:Image name="skill-slot-icon" class="skill-slot-icon" style="display: none;"/>
                                <ui:Label name="skill-slot-name" class="skill-slot-name"/>
                                <ui:Label text="＋" name="skill-slot-placeholder" class="skill-slot-placeholder" style="font-size: 100px;"/>
                            </ui:VisualElement>
                            <ui:VisualElement name="ComboRow" class="skillbuild-slot-combo-row"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="SkillSlot3" class="skill-element-slot skillbuild-slot" style="display: none; height: 250px; width: 250px;">
                            <ui:VisualElement name="IconArea" class="skillbuild-slot-icon-area">
                                <ui:Image name="skill-slot-icon" class="skill-slot-icon" style="display: none;"/>
                                <ui:Label name="skill-slot-name" class="skill-slot-name"/>
                                <ui:Label text="＋" name="skill-slot-placeholder" class="skill-slot-placeholder"/>
                            </ui:VisualElement>
                            <ui:VisualElement name="ComboRow" class="skillbuild-slot-combo-row"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Button text="Save" name="SkillBuildSaveButton" emoji-fallback-support="true" class="button ui-se-select skillbuild-action-button" style="height: 85px; background-image: url(&quot;project://database/Assets/Arts/Images/Sprites/UI/OutGame/UI_Save_Button.png?fileID=2800000&amp;guid=e7bc8f7e357917341903e0cafdd4a155&amp;type=3#UI_Save_Button&quot;); background-color: rgba(255, 255, 255, 0); width: 434px; -unity-background-scale-mode: scale-to-fit; background-position-x: center; margin-left: 200px; margin-right: 200px; font-size: 50px; color: rgb(255, 255, 255); -unity-text-align: middle-left; padding-left: 138px; -unity-font-style: bold; letter-spacing: 5px;"/>
                </ui:VisualElement>
                <ui:VisualElement name="ListActionsSection" class="skillbuild-list-actions-section" style="margin-top: 5px;">
                    <ui:VisualElement name="SkillListPanel" class="skillbuild-panel skillbuild-panel-nested skillbuild-list-panel">
                        <ui:VisualElement name="SkillGenreFilterBar" class="skill-genre-filter-bar"/>
                        <ui:VisualElement name="BottomSection" class="skillbuild-list-section">
                            <ui:ScrollView name="SkillScrollView" mode="Horizontal" vertical-scroller-visibility="Hidden" touch-scroll-type="Elastic" horizontal-scroller-visibility="Hidden" class="skillbuild-list-scrollview">
                                <ui:VisualElement class="skill-element-list" style="flex-grow: 0; flex-direction: row; height: auto; justify-content: flex-start; align-self: center; margin-left: 0;"/>
                            </ui:ScrollView>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="BottomRow" class="skillbuild-bottom-row" style="width: 700px; justify-content: space-evenly; align-self: flex-start; margin-left: 77px; margin-top: 0;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Instance template="SkillBuildDialog" name="SkillBuildDialog" style="position: absolute; width: 100%; height: 100%; display: none;"/>
    </ui:VisualElement>
</ui:UXML>
