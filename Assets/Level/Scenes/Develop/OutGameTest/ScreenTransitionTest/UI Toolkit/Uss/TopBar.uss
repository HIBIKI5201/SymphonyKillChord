:root {
}

.title {
    position: absolute;
    left: 50%;
    translate: -50% 0;
}

.back-button {
    position: absolute;
    left: 1%;
    width: 187.5px;
    height: 100px;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Arts/Images/Sprites/UI/WIP/BackPanel.png?fileID=21300000&guid=3bbc7964560a56647ad92d08d25c4138&type=3#BackPanel");
    -unity-background-scale-mode: scale-to-fit;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

/*
    設定画面ショートカットボタン。ホーム画面の設定ボタン(.home-option-button)と
    同じ枠+歯車アイコンの2層構成。サイズのみこの画面用に上書きする。
*/
.setting-shortcut-button {
    position: absolute;
    left: 190px;
    width: 100px;
    height: 100px;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.home-top-bar {
    position: absolute;
    left: 24px;
    top: 0;
    width: 572px;
    height: 131px;
    background-image: url("project://database/Assets/Arts/Images/Sprites/UI/OutGame/UI_OutGame_SceneTab.png?fileID=21300000&guid=96c8d94dd68b3104fa34a3f388529d63&type=3#UI_OutGame_SceneTab");
    -unity-background-scale-mode: scale-to-fit;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 20px;
    padding-right: 24px;
}

.home-option-icon-glyph {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.back-button:hover,
.back-button:focus,
.setting-shortcut-button:hover,
.setting-shortcut-button:focus {
    scale: 1.0 1.0;
    box-shadow: 0 0 12px 2px rgba(255, 255, 255, 0.8);
    -unity-background-image-tint-color: rgb(170, 170, 170);
    transition-duration: 0.05s;
    transition-timing-function: ease-out-circ;
}

.setting-shortcut-button:hover > .home-option-icon-glyph,
.setting-shortcut-button:focus > .home-option-icon-glyph {
    -unity-background-image-tint-color: rgb(170, 170, 170);
    opacity: 0.55;
}

.home-points-row {
    flex-direction: row;
    align-items: center;
}

.home-point-label {
    color: rgb(255, 255, 255);
    font-size: 22px;
    -unity-font-style: bold;
    margin-left: 24px;
}
