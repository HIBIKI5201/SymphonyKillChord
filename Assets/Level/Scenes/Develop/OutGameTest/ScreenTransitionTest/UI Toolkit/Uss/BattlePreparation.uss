.battle-preparation-screen {
    flex-grow: 1;
    padding-top: 2%;
    padding-right: 3%;
    padding-bottom: 2%;
    padding-left: 3%;
    flex-direction: row;
}

.battle-preparation-title {
    flex-shrink: 0;
    height: 8%;
    min-height: 56px;
    font-size: 36px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.battle-preparation-content {
    flex-grow: 1;
    min-height: 0;
    align-items: flex-end;
    justify-content: center;
    height: 100%;
    width: 15%;
}

.battle-preparation-panel {
    width: 100%;
    max-width: 960px;
    height: 100%;
    min-height: 0;
    padding-top: 20px;
    padding-right: 24px;
    padding-bottom: 20px;
    padding-left: 24px;
    background-color: rgba(27, 36, 48, 0.94);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: rgb(207, 218, 229);
    border-right-color: rgb(207, 218, 229);
    border-bottom-color: rgb(207, 218, 229);
    border-left-color: rgb(207, 218, 229);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
    border-bottom-left-radius: 12px;
}

.battle-preparation-section-title {
    flex-shrink: 0;
    margin-bottom: 10px;
    color: rgb(245, 247, 250);
    font-size: 24px;
    -unity-font-style: bold;
}

.battle-preparation-skill-strip {
    flex-shrink: 0;
    min-height: 140px;
    margin-bottom: 18px;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
}

.battle-preparation-equipped-skill {
    width: 132px;
    margin-right: 16px;
    margin-bottom: 8px;
    align-items: center;
}

.battle-preparation-equipped-skill--empty {
    opacity: 0.55;
}

.battle-preparation-skill-icon {
    width: 92px;
    height: 92px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background-color: rgb(66, 81, 99);
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    border-top-color: rgb(225, 231, 238);
    border-right-color: rgb(225, 231, 238);
    border-bottom-color: rgb(225, 231, 238);
    border-left-color: rgb(225, 231, 238);
    border-top-left-radius: 46px;
    border-top-right-radius: 46px;
    border-bottom-right-radius: 46px;
    border-bottom-left-radius: 46px;
}

.battle-preparation-skill-icon--empty {
    opacity: 0.55;
}

.battle-preparation-skill-icon__image {
    width: 100%;
    height: 100%;
}

.battle-preparation-skill-icon__fallback {
    color: rgb(245, 247, 250);
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.battle-preparation-equipped-skill__name {
    width: 100%;
    margin-top: 6px;
    color: rgb(245, 247, 250);
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    white-space: normal;
}

.battle-preparation-effect-scroll {
    flex-grow: 1;
    min-height: 140px;
    margin-bottom: 18px;
    padding-top: 12px;
    padding-right: 12px;
    padding-bottom: 12px;
    padding-left: 12px;
    background-color: rgba(244, 247, 250, 0.96);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: rgb(138, 151, 166);
    border-right-color: rgb(138, 151, 166);
    border-bottom-color: rgb(138, 151, 166);
    border-left-color: rgb(138, 151, 166);
}

.battle-preparation-effect-list {
    flex-grow: 1;
}

.battle-preparation-skill-item {
    flex-shrink: 0;
    margin-bottom: 12px;
    padding-top: 12px;
    padding-right: 14px;
    padding-bottom: 12px;
    padding-left: 14px;
    background-color: rgb(224, 230, 237);
    border-bottom-width: 2px;
    border-bottom-color: rgb(163, 174, 187);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
}

.battle-preparation-skill-item--empty {
    opacity: 0.65;
}

.battle-preparation-skill-item__name {
    margin-bottom: 5px;
    color: rgb(28, 35, 44);
    font-size: 24px;
    -unity-font-style: bold;
    white-space: normal;
}

.battle-preparation-skill-item__combo {
    margin-bottom: 5px;
    color: rgb(39, 53, 68);
    font-size: 20px;
    white-space: normal;
}

.battle-preparation-skill-item__type-row {
    flex-direction: row;
    margin-top: 5px;
}

.battle-preparation-skill-item__type-heading,
.battle-preparation-skill-item__type {
    color: rgb(28, 35, 44);
    font-size: 20px;
    -unity-font-style: bold;
    white-space: normal;
}

.battle-preparation-skill-item__type {
    flex-grow: 1;
}

.battle-preparation-skill-item__effect-heading {
    margin-top: 8px;
    color: rgb(28, 35, 44);
    font-size: 20px;
    -unity-font-style: bold;
}

.battle-preparation-skill-item__description {
    margin-top: 2px;
    margin-left: 24px;
    color: rgb(28, 35, 44);
    font-size: 20px;
    white-space: normal;
}

.battle-preparation-footer {
    flex-shrink: 0;
    min-height: 88px;
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
}

.battle-preparation-start-button,
.battle-preparation-back-button {
    width: 40%;
    height: 72px;
    min-height: 56px;
    margin-left: 10px;
    font-size: 24px;
    background-color: rgb(188, 188, 188);
    border-top-left-radius: 11px;
    border-top-right-radius: 11px;
    border-bottom-right-radius: 11px;
    border-bottom-left-radius: 11px;
}

.battle-preparation-start-button {
    background-color: rgb(197, 221, 170);
}

.battle-preparation-character-image {
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
    width: 49%;
    min-width: 431px;
    height: 80%;
    min-height: 900px;
    display: flex;
}

.battle-preparation-character-content {
    flex-grow: 1;
    flex-shrink: 0;
    min-width: 90px;
    align-items: center;
    justify-content: flex-end;
    height: 100%;
    width: 5%;
}
