.setting-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.55);
    padding-top: 3%;
    padding-right: 5%;
    padding-bottom: 3%;
    padding-left: 5%;
}

.setting-window {
    width: 94%;
    height: 88%;
    min-height: 520px;
    padding: 20px;
    background-color: rgb(50, 58, 64);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(150, 162, 170);
    border-right-color: rgb(150, 162, 170);
    border-top-color: rgb(150, 162, 170);
    border-bottom-color: rgb(150, 162, 170);
}

.setting-top-bar {
    height: 72px;
    flex-direction: row;
    align-items: center;
    margin-bottom: 16px;
}

.setting-back-button {
    width: 230px;
    height: 58px;
    font-size: 26px;
    color: white;
    background-color: rgb(83, 94, 102);
}

.setting-title {
    flex-grow: 1;
    margin-right: 230px;
    font-size: 38px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: white;
}

.setting-layout {
    flex-grow: 1;
    flex-direction: row;
    min-height: 0;
}

.setting-category-list {
    width: 25%;
    min-width: 220px;
    padding-right: 14px;
}

.setting-category-button {
    height: 72px;
    margin-bottom: 12px;
    padding-left: 22px;
    border-left-width: 6px;
    border-left-color: rgb(150, 162, 170);
    font-size: 27px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: rgb(218, 224, 228);
    background-color: rgb(69, 78, 84);
}

.setting-category-button--selected {
    border-left-color: rgb(113, 205, 232);
    color: white;
    background-color: rgb(83, 112, 126);
}

.setting-content-scroll {
    flex-grow: 1;
    min-width: 0;
    background-color: rgb(61, 70, 76);
}

.setting-panel {
    flex-grow: 1;
    padding: 22px 26px;
}

.setting-panel-title {
    height: 52px;
    margin-bottom: 12px;
    font-size: 32px;
    -unity-font-style: bold;
    color: white;
}

.setting-row {
    min-height: 138px;
    margin-bottom: 14px;
    padding: 14px 18px;
    background-color: rgb(72, 82, 89);
}

.setting-row-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.setting-row-label {
    width: 150px;
    font-size: 26px;
    -unity-font-style: bold;
    color: white;
}

.setting-control-row {
    flex-direction: row;
    align-items: center;
    min-height: 54px;
}



.setting-value-label {
    width: 48px;
    margin-right: 10px;
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: white;
    background-color: rgb(42, 48, 52);
}

.setting-slider {
    flex-grow: 1;
    min-width: 220px;
    height: 48px;
}

.setting-system-description {
    margin-top: 16px;
    margin-bottom: 8px;
    font-size: 26px;
    color: white;
}

.setting-system-note {
    margin-bottom: 30px;
    font-size: 21px;
    color: rgb(218, 224, 228);
}

.setting-return-title-button {
    width: 360px;
    height: 70px;
    align-self: flex-end;
    font-size: 25px;
    -unity-font-style: bold;
    color: white;
    background-color: rgb(145, 70, 70);
}

.setting-dialog-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.72);
}

.setting-dialog {
    width: 560px;
    min-height: 250px;
    padding: 28px;
    justify-content: center;
    background-color: rgb(58, 66, 72);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(180, 188, 194);
    border-right-color: rgb(180, 188, 194);
    border-top-color: rgb(180, 188, 194);
    border-bottom-color: rgb(180, 188, 194);
}

.setting-dialog-message {
    margin-bottom: 32px;
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: white;
}

.setting-dialog-buttons {
    flex-direction: row;
    justify-content: center;
}

.setting-dialog-button {
    width: 220px;
    height: 62px;
    margin-left: 8px;
    margin-right: 8px;
    font-size: 22px;
}

.setting-dialog-confirm {
    color: white;
    background-color: rgb(145, 70, 70);
}

.setting-layout--narrow {
    flex-direction: column;
}

.setting-layout--narrow .setting-category-list {
    width: 100%;
    min-width: 0;
    height: 72px;
    padding-right: 0;
    flex-direction: row;
}

.setting-layout--narrow .setting-category-button {
    flex-grow: 1;
    height: 62px;
    margin-right: 8px;
    border-left-width: 0;
    border-bottom-width: 6px;
    border-bottom-color: rgba(0, 0, 0, 0);
    -unity-text-align: middle-center;
}

.setting-layout--narrow .setting-category-button--selected {
    border-bottom-color: rgb(113, 205, 232);
}

.setting-layout--narrow .setting-content-scroll {
    width: 100%;
}
