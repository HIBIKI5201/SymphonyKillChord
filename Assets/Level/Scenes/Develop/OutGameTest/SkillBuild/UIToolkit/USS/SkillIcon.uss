:root {
}

.skill-icon {
    position: relative;
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-right-radius: 50%;
    border-bottom-left-radius: 50%;
    min-width: 150px;
    min-height: 150px;
    background-color: rgb(145, 145, 145);
    height: 150px;
    width: 150px;
    overflow: hidden;
    margin-left: 1%;
    margin-right: 1%;
    border-left-width: 4px;
    border-right-width: 4px;
    border-top-width: 4px;
    border-bottom-width: 4px;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
}

.skill-icon-image {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.skill-name {
    position: absolute;
    left: 6px;
    right: 6px;
    bottom: 12px;
    min-height: 32px;
    background-color: rgba(0, 0, 0, 0.65);
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 18px;
    white-space: normal;
}

.skill-icon:hover {
    border-left-color: rgb(92, 225, 230);
    border-right-color: rgb(92, 225, 230);
    border-top-color: rgb(92, 225, 230);
    border-bottom-color: rgb(92, 225, 230);
}

.is-selected .skill-icon {
    border-left-color: rgb(255, 193, 7);
    border-right-color: rgb(255, 193, 7);
    border-top-color: rgb(255, 193, 7);
    border-bottom-color: rgb(255, 193, 7);
}
