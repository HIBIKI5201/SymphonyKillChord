:root {
}

.owned-points {
    position: absolute;
    right: 240px;
    top: 10px;
    width: 280px;
    height: 80px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: rgb(217, 217, 217);
}

.owned-points-heading {
    font-size: 24px;
    -unity-font-style: bold;
}

.owned-points-value {
    font-size: 24px;
    -unity-font-style: bold;
}

.skill-icon {
    height: 100%;
    margin-right: 4%;
    margin-left: 4%;
}

.skill-detail-top {
    flex-grow: 0;
    width: 100%;
    height: 25%;
    flex-direction: row;
    align-items: center;
    padding-left: 2%;
    padding-right: 2%;
}

.skill-detail-icon {
    width: 110px;
    height: 110px;
    min-width: 110px;
    min-height: 110px;
    background-color: rgb(145, 145, 145);
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-right-radius: 50%;
    border-bottom-left-radius: 50%;
    -unity-background-scale-mode: scale-to-fit;
}

.skill-detail-heading {
    flex-grow: 1;
    margin-left: 24px;
    justify-content: center;
}

.skill-name-label {
    font-size: 30px;
    -unity-font-style: bold;
    white-space: normal;
}

.skill-combo-label {
    margin-top: 8px;
    font-size: 22px;
    white-space: normal;
}

.skill-description {
    flex-grow: 0;
    width: 95%;
    height: 50%;
    align-self: center;
    border-top-width: 6px;
    border-right-width: 6px;
    border-bottom-width: 6px;
    border-left-width: 6px;
    border-top-left-radius: 25px;
    border-top-right-radius: 25px;
    border-bottom-right-radius: 25px;
    border-bottom-left-radius: 25px;
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
}

.skill-type-row {
    width: 95%;
    align-self: center;
    padding-top: 16px;
    flex-direction: row;
}

.skill-type-heading {
    font-size: 24px;
    -unity-font-style: bold;
    white-space: normal;
}

.skill-type-label {
    flex-grow: 1;
    font-size: 24px;
    -unity-font-style: bold;
    white-space: normal;
}

.skill-effect-heading {
    width: 95%;
    align-self: center;
    margin-top: 12px;
    font-size: 24px;
    -unity-font-style: bold;
}

.skill-description-label {
    width: 92%;
    align-self: center;
    padding-top: 4px;
    padding-bottom: 16px;
    padding-left: 24px;
    font-size: 24px;
    -unity-font-style: bold;
    white-space: normal;
}

.skill-tips-heading {
    width: 95%;
    align-self: center;
    margin-top: 12px;
    font-size: 24px;
    -unity-font-style: bold;
}

.skill-tips-label {
    width: 92%;
    align-self: center;
    padding-top: 4px;
    padding-bottom: 16px;
    padding-left: 24px;
    font-size: 24px;
    -unity-font-style: bold;
    white-space: normal;
}

.skill-element-slot {
    align-items: center;
    justify-content: center;
}

.skill-slot-icon {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-right-radius: 50%;
    border-bottom-left-radius: 50%;
    -unity-background-scale-mode: scale-to-fit;
}

.skill-slot-name {
    position: absolute;
    left: 6px;
    right: 6px;
    bottom: 12px;
    min-height: 24px;
    background-color: rgba(0, 0, 0, 0.65);
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 14px;
    white-space: normal;
    display: none;
}

.skill-slot-placeholder {
    color: rgb(200, 200, 200);
    font-size: 32px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.skill-element-slot.is-filled .skill-slot-placeholder {
    display: none;
}

.skill-element-slot.is-filled .skill-slot-name {
    display: flex;
}

.draggable {
}

.skill-element-container {
}

.skill-element-list {
}

/*
    SkillListView がスキルアイコン(Skill.uxml)の外側へ直接生成する要素
    (グループ枠・区切り線)は Skill.uxml のスタイル(SkillIcon.uss)の
    適用範囲外(Skill.uxml の TemplateContainer の子孫ではない)ため、
    ここ(画面ルートから読み込まれる SkillBuildScreen.uss)にも定義する。
*/
.skill-group-divider {
    flex: 0 0 auto;
    width: 4px;
    height: 150px;
    align-self: center;
    margin-left: 16px;
    margin-right: 16px;
    background-color: rgb(120, 120, 120);
}

.skill-genre-filter-bar {
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    padding-left: 12px;
}

.skill-genre-filter-button-all,
.skill-genre-filter-button {
    flex: 0 0 auto;
    width: 64px;
    height: 64px;
    margin-right: 14px;
    padding: 0;
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-right-radius: 50%;
    border-bottom-left-radius: 50%;
    background-color: rgb(255, 255, 255);
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-left-color: rgb(120, 120, 120);
    border-right-color: rgb(120, 120, 120);
    border-top-color: rgb(120, 120, 120);
    border-bottom-color: rgb(120, 120, 120);
}

.skill-genre-filter-button-all {
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.skill-genre-filter-button-icon {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.skill-genre-filter-button-all.is-active,
.skill-genre-filter-button.is-active {
    border-left-color: rgb(255, 193, 7);
    border-right-color: rgb(255, 193, 7);
    border-top-color: rgb(255, 193, 7);
    border-bottom-color: rgb(255, 193, 7);
}

.skill-group-container {
    flex: 0 0 auto;
    flex-direction: row;
    align-items: center;
    align-self: center;
    height: 174px;
    padding-left: 12px;
    padding-right: 12px;
    border-top-left-radius: 24px;
    border-top-right-radius: 24px;
    border-bottom-right-radius: 24px;
    border-bottom-left-radius: 24px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(120, 120, 120);
    border-right-color: rgb(120, 120, 120);
    border-top-color: rgb(120, 120, 120);
    border-bottom-color: rgb(120, 120, 120);
}
