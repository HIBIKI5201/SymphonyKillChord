.setting-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.55);
}

.setting-window {
    position: absolute;
    left: 0;
    top: 0;
    width: 572px;
    height: 1090px;
    padding: 40px 40px;
    -unity-background-scale-mode: scale-to-fit;
}

.setting-window--menu {
    background-image: url("project://database/Assets/Arts/Images/Sprites/UI/OutGame/UI_Option_Back.png?fileID=21300000&guid=ae2a34555d2331543a19da0a6aa5a2cb&type=3#UI_Option_Back");
}

.setting-window--audio {
    background-image: url("project://database/Assets/Arts/Images/Sprites/UI/OutGame/UI_Option_Back.png?fileID=21300000&guid=ae2a34555d2331543a19da0a6aa5a2cb&type=3#UI_Option_Back");
}

.setting-window--environment {
    background-image: url("project://database/Assets/Arts/Images/Sprites/UI/OutGame/UI_Option_Back.png?fileID=21300000&guid=ae2a34555d2331543a19da0a6aa5a2cb&type=3#UI_Option_Back");
}

.setting-top-bar {
    margin-bottom: 28px;
}

.setting-title {
    font-size: 38px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: white;
    margin-bottom: 12px;
}

.setting-title-divider {
    height: 2px;
    background-color: rgba(255, 255, 255, 0.75);
}

.setting-menu {
    flex-grow: 1;
    min-height: 0;
}

.setting-menu-list {
    flex-shrink: 0;
}

.setting-menu-spacer {
    flex-grow: 1;
}

.setting-menu-button {
    height: 72px;
    margin-bottom: 16px;
    font-size: 27px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(58, 47, 20);
}

.setting-menu-button:hover,
.setting-menu-button:focus,
.setting-menu-button:active {
    color: white;
}

.setting-panel {
    flex-grow: 1;
    min-height: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
}

.setting-panel-top-bar {
    position: relative;
    height: 44px;
    justify-content: center;
    margin-bottom: 12px;
}

.setting-panel-back-button {
    position: absolute;
    left: 0;
    top: 0;
    width: 44px;
    height: 44px;
    font-size: 28px;
    color: white;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.setting-panel-title {
    width: 100%;
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: white;
}

.setting-row {
    flex-direction: row;
    align-items: center;
    min-height: 64px;
    margin-top: 26px;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
}

.setting-row-header {
    width: 90px;
    flex-direction: row;
    align-items: center;
}

.setting-row-label {
    width: 90px;
    font-size: 24px;
    -unity-font-style: bold;
    color: white;
}

.setting-control-row {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    min-height: 40px;
}

.setting-value-label {
    display: none;
}

.setting-slider {
    flex-grow: 1;
    min-width: 220px;
    height: 40px;
}

.setting-slider .unity-base-slider__tracker {
    top: 50%;
    height: 4px;
    margin-top: -2px;
    background-color: rgb(253, 246, 224);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.setting-slider .unity-base-slider__dragger {
    width: 20px;
    height: 20px;
    border-radius: 10px;
    background-color: rgb(63, 212, 240);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.setting-select-row {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    min-height: 40px;
}

.setting-select-value-label {
    flex-grow: 1;
    -unity-text-align: middle-center;
    font-size: 22px;
    color: white;
}

.setting-dialog-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.72);
}

.setting-dialog {
    width: 640px;
    min-height: 260px;
    padding: 32px 40px;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Arts/Images/Sprites/UI/OutGame/UI_OutGame_SceneTab.png?fileID=21300000&guid=96c8d94dd68b3104fa34a3f388529d63&type=3#UI_OutGame_SceneTab");
    -unity-background-scale-mode: stretch-to-fill;
}

.setting-dialog-message {
    margin-bottom: 32px;
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: white;
    white-space: normal;
}

.setting-dialog-buttons {
    flex-direction: row;
    justify-content: center;
}

.setting-dialog-button {
    width: 260px;
    height: 72px;
    margin-left: 8px;
    margin-right: 8px;
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    color: rgb(58, 47, 20);
    background-color: rgba(0, 0, 0, 0);
}

.setting-dialog-button:hover,
.setting-dialog-button:focus,
.setting-dialog-button:active {
    color: white;
}
