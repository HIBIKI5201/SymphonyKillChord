<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="Home" src="project://database/Assets/Level/UI/OutGame/Screen/Home.uxml?fileID=9197481963319205126&amp;guid=d6056ed1cde932548a8de79a607b99c6&amp;type=3#Home"/>
    <ui:Template name="Setting" src="project://database/Assets/Level/UI/OutGame/Screen/Setting.uxml?fileID=9197481963319205126&amp;guid=c0bfd75645ca6fd4e95372f8837c05d5&amp;type=3#Setting"/>
    <ui:Template name="SkillConfiguration" src="project://database/Assets/Level/UI/OutGame/Screen/SkillBuild.uxml?fileID=9197481963319205126&amp;guid=d25d21c4589e34248aa3ead41ca37903&amp;type=3#SkillBuild"/>
    <ui:Template name="SkillTree" src="project://database/Assets/Level/UI/OutGame/Screen/SkillTree.uxml?fileID=9197481963319205126&amp;guid=71fa5cfbe14c0f24a9c468147eb5fef7&amp;type=3#SkillTree"/>
    <ui:Template name="StageSelect" src="project://database/Assets/Level/UI/OutGame/Screen/StageSelect.uxml?fileID=9197481963319205126&amp;guid=6114da1f8d46b1a48ab03c626ed1d9e9&amp;type=3#StageSelect"/>
    <Style src="project://database/Assets/Level/UI/OutGame/Screen/USS/Layer.uss?fileID=7433441132597879392&amp;guid=b30038ace8edcc245a8817f3a1b52b55&amp;type=3#Layer"/>
    <Style src="project://database/Assets/Level/UI/OutGame/Screen/USS/OutGameScreen.uss?fileID=7433441132597879392&amp;guid=2873ded5d140af5419fca59e2bf1d22c&amp;type=3#OutGameScreen"/>
    <Style src="project://database/Assets/Level/UI/OutGame/Screen/USS/OutGameNavigation.uss?fileID=7433441132597879392&amp;guid=606450f367b1594449ec1a91c2a55f34&amp;type=3#OutGameNavigation"/>
    <Style src="project://database/Assets/Level/UI/OutGame/Screen/USS/InputGuide.uss?fileID=7433441132597879392&amp;guid=170f34246cbe4f8f8c021e6ec940d50d&amp;type=3#InputGuide"/>
    <ui:VisualElement name="VisualElement" picking-mode="Ignore" style="flex-grow: 1; background-color: rgba(53, 65, 72, 0);">
        <ui:VisualElement name="ScreenLayer" picking-mode="Ignore" class="layer" style="flex-grow: 1;">
            <ui:Instance template="Home" name="HomeContainer" class="screen" style="height: 100%; width: 100%; position: absolute;"/>
            <ui:Instance template="StageSelect" name="StageSelectContainer" class="screen" style="position: absolute; width: 100%; height: 100%; display: none;"/>
            <ui:Instance template="SkillTree" name="SkillTreeContainer" class="screen" style="position: absolute; width: 100%; height: 100%; display: none;"/>
            <ui:Instance template="SkillConfiguration" name="SkillBuildContainer" class="screen" style="position: absolute; width: 100%; height: 100%; display: none;"/>
        </ui:VisualElement>
        <ui:VisualElement name="OverlayLayer" picking-mode="Ignore" class="layer" style="flex-grow: 1;">
            <ui:Instance template="Setting" name="SettingContainer" picking-mode="Position" style="position: absolute; width: 100%; height: 100%; display: flex; color: rgba(0, 0, 0, 0.4); background-color: rgba(0, 0, 0, 0.4);"/>
        </ui:VisualElement>
        <ui:VisualElement name="InputGuide" picking-mode="Ignore" class="input-guide">
            <ui:VisualElement name="SubmitGuide" picking-mode="Ignore" class="input-guide-item">
                <ui:Label text="B" picking-mode="Ignore" class="input-guide-badge input-guide-badge--submit"/>
                <ui:Label text="決定" picking-mode="Ignore" class="input-guide-label"/>
            </ui:VisualElement>
            <ui:VisualElement name="CancelGuide" picking-mode="Ignore" class="input-guide-item">
                <ui:Label text="A" picking-mode="Ignore" class="input-guide-badge input-guide-badge--cancel"/>
                <ui:Label text="戻る" picking-mode="Ignore" class="input-guide-label"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
