:root {
}

.tab-root {
    background-color: rgb(123, 123, 123);
    width: 70%;
    height: 70%;
    align-self: center;
}

.unity-tab {
    width: 100%;
    height: 100%;
    flex-grow: 1;
}

.tab-view {
    padding: 5px;
    width: 100%;
    height: 100%;
    flex-grow: 1;
    padding-top: 0%;
    padding-right: 2%;
    padding-bottom: 2%;
    padding-left: 2%;
    margin-top: 4%;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
}

.unity-tab-view__header-container {
    align-items: stretch;
    justify-content: flex-end;
    width: 100%;
    height: 100%;
}

.unity-tab__header {
    width: auto;
    min-width: 0;
    height: 80px;
    padding-left: 24px;
    padding-right: 24px;
    margin-left: 6px;
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Arts/Images/Sprites/UI/OutGame/UI_Panel_tab_off.png?fileID=21300000&guid=c27ffb2c61799194fbed912bd417a179&type=3#UI_Panel_tab_off");
    -unity-background-scale-mode: stretch-to-fill;
}

.unity-tab__header-label {
    width: 100%;
    height: 100%;
    -unity-font-style: bold;
    font-size: 22px;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
}

.unity-tab__header:checked {
    background-image: url("project://database/Assets/Arts/Images/Sprites/UI/OutGame/UI_Panel_tab.png?fileID=21300000&guid=2634097f27d94f04cab60440a40fcb28&type=3#UI_Panel_tab");
    border-left-color: rgb(120, 20, 34);
    border-right-color: rgb(120, 20, 34);
    border-top-color: rgb(120, 20, 34);
    border-bottom-color: rgb(120, 20, 34);
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 5px;
}

/* TabView の選択色よりフォーカス表示を優先し、操作対象を明示する。 */
.tab-root .navigable:focus {
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(255, 220, 90);
    border-right-color: rgb(255, 220, 90);
    border-top-color: rgb(255, 220, 90);
    border-bottom-color: rgb(255, 220, 90);
    --unity-focus-outline-color: rgba(0, 0, 0, 0);
}

.tab-root .navigable:disabled:focus {
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
}

.unity-tab__header-underline {
    opacity: 0;
}

.unity-tab__content-container {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0);
}

.unity-tab-view__content-container {
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0);
}

.audio-volume-slider {
    width: 90%;
    align-self: center;
    margin-top: 10%;
    height: auto;
}

.unity-slider__label {
    font-size: 24px;
    -unity-font-style: bold;
}

.role-label {
    color: rgb(255, 255, 255);
}
