<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xmlns:screen="KillChord.Runtime.View.OutGame.Screen" noNamespaceSchemaLocation="../../../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Level/UI/OutGame/Title/USS/Option.uss?fileID=7433441132597879392&amp;guid=a72d4d74f09284c488b35de6f07827a6&amp;type=3"/>
    <Style src="project://database/Assets/Level/UI/OutGame/Screen/USS/Button.uss?fileID=7433441132597879392&amp;guid=1e78d0c0c6f33384896221d772a80442&amp;type=3"/>
    <Style src="project://database/Assets/Level/UI/OutGame/Screen/USS/TopBar.uss?fileID=7433441132597879392&amp;guid=bb5c6f023ae9b494f9e906f04015c185&amp;type=3"/>
    <Style src="project://database/Assets/Level/UI/OutGame/Title/USS/Credit.uss?fileID=7433441132597879392&amp;guid=97c794b417049b9468c00cc640f15ab6&amp;type=3"/>
    <ui:VisualElement name="BackGround" style="width: 100%; height: 100%; justify-content: center; background-color: rgba(0, 0, 0, 0);">
        <ui:VisualElement name="Root" class="tab-root" style="background-image: url(&quot;project://database/Assets/Arts/Images/Sprites/UI/OutGame/UI_MenuPanel.png?fileID=2800000&amp;guid=e93604348792fe147b00edd554ae46a0&amp;type=3#UI_MenuPanel&quot;); background-color: rgba(123, 123, 123, 0);">
            <ui:TabView class="tab-view">
                <ui:Tab label="制作メンバー" name="ProductionTeam" class="ui-se-select" style="width: 100%;">
                    <ui:VisualElement name="BackGroundImage" picking-mode="Ignore" style="position: absolute; left: 0; top: 0; width: 100%; height: 566px; opacity: 0.1; background-image: url(&quot;project://database/Assets/Arts/Images/Sprites/UI/OutGame/UI_Back_Text.png?fileID=2800000&amp;guid=522fda19571fbc24db0d164d903c2ea9&amp;type=3#UI_Back_Text&quot;);"/>
                    <ui:ScrollView name="MemberScrollView" mode="Vertical" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden" style="height: 566px; width: 100%;">
                        <ui:Label text="Label"/>
                    </ui:ScrollView>
                </ui:Tab>
                <ui:Tab label="使用アセット" name="AssetsUsed" class="ui-se-select">
                    <ui:VisualElement name="BackGround" style="width: 100%; height: 566px; flex-grow: 1; position: relative;">
                        <ui:VisualElement name="BackGroundImage" picking-mode="Ignore" style="position: absolute; left: 0; top: 0; width: 100%; height: 100%; opacity: 0.1; background-image: url(&quot;project://database/Assets/Arts/Images/Sprites/UI/OutGame/UI_Back_Text.png?fileID=2800000&amp;guid=522fda19571fbc24db0d164d903c2ea9&amp;type=3#UI_Back_Text&quot;);"/>
                        <ui:ListView style="width: 100%; height: 100%;"/>
                    </ui:VisualElement>
                </ui:Tab>
            </ui:TabView>
            <screen:AlphaHitTestButton name="BackButton" class="back-button button ui-se-cancel" style="position: absolute; top: 8px; left: 15px;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
