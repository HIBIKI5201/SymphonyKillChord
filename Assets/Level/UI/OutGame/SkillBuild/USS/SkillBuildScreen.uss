:root {
}

.skillbuild-root {
    flex-direction: column;
    background-color: rgb(12, 21, 38);
    padding: 16px;
    position: relative;
    -unity-font-definition: url("project://database/Assets/Arts/Fonts/IBMPlexSerif-Regular.ttf?fileID=12800000&guid=29590e29353b0f84591dcd8c59e135c8&type=3#IBMPlexSerif-Regular");
}

.skillbuild-header-points {
    flex-direction: row;
    align-items: center;
}

.skillbuild-header-points-heading,
.skillbuild-header-points-value {
    color: rgb(255, 255, 255);
    font-size: 20px;
    -unity-font-style: bold;
}

.skillbuild-body-row {
    flex-direction: row;
    flex-grow: 1;
    justify-content: space-between;
    margin-top: 150px;
}

.skillbuild-panel {
    width: 47%;
    height: 100%;
    flex-direction: column;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Arts/Images/Sprites/UI/OutGame/UI_Build_Panel.png?fileID=21300000&guid=a54aaa7603081784687325749f91661e&type=3#UI_Build_Panel");
    -unity-background-scale-mode: stretch-to-fill;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(58, 84, 135);
    border-right-color: rgb(58, 84, 135);
    border-top-color: rgb(58, 84, 135);
    border-bottom-color: rgb(58, 84, 135);
    padding: 20px 16px 16px 16px;
}

.skillbuild-formation-column {
    width: 47%;
    height: 100%;
    flex-direction: column;
}

.skillbuild-panel-nested {
    width: 100%;
    height: auto;
    flex-grow: 0;
}

.skillbuild-list-actions-section {
    flex-grow: 1;
    flex-direction: column;
    justify-content: flex-start;
}

.skillbuild-list-panel {
    flex-grow: 0;
    margin-top: 12px;
    padding: 0;
}

.skillbuild-list-scrollview #unity-horizontal-scroller,
.skillbuild-list-scrollview .unity-scroller--horizontal,
.skillbuild-list-scrollview .unity-base-slider--horizontal .unity-scroller__low-button,
.skillbuild-list-scrollview .unity-base-slider--horizontal .unity-scroller__high-button,
.skillbuild-list-scrollview .unity-scroller__low-button,
.skillbuild-list-scrollview .unity-scroller__high-button {
    display: none;
}

.skillbuild-panel-title {
    align-self: flex-start;
    margin-bottom: 14px;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Arts/Images/Sprites/UI/OutGame/OutGame_NameTab.png?fileID=21300000&guid=18615c4bf6c358c419b0f3486d76158e&type=3#OutGame_NameTab");
    -unity-background-scale-mode: stretch-to-fill;
    color: rgb(255, 255, 255);
    font-size: 26px;
    -unity-font-style: bold;
    padding: 6px 22px;
}

.owned-points {
    position: absolute;
    right: 240px;
    top: 10px;
    width: 280px;
    height: 80px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: rgb(217, 217, 217);
}

.owned-points-heading {
    font-size: 24px;
    -unity-font-style: bold;
}

.owned-points-value {
    font-size: 24px;
    -unity-font-style: bold;
}

.skill-icon {
    height: 100%;
    margin-right: 0;
    margin-left: 0;
}

.skillbuild-detail-content {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Arts/Images/Sprites/UI/OutGame/UI_Back_Text.png?fileID=21300000&guid=522fda19571fbc24db0d164d903c2ea9&type=3#UI_Back_Text");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.2);
    padding: 16px 16px 8px 16px;
}

.skill-detail-top {
    flex-grow: 0;
    width: 100%;
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.skill-detail-icon {
    width: 170px;
    height: 170px;
    min-width: 170px;
    min-height: 170px;
    background-color: rgb(0, 0, 0);
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-right-radius: 50%;
    border-bottom-left-radius: 50%;
    -unity-background-scale-mode: scale-to-fit;
}

.skill-detail-heading {
    flex-grow: 1;
    align-self: flex-start;
    margin-left: 20px;
    margin-top: 14px;
    justify-content: center;
}

.skill-name-label {
    font-size: 36px;
    -unity-font-style: bold;
    white-space: normal;
    color: rgb(255, 255, 255);
}

.skill-combo-label {
    margin-top: 8px;
    font-size: 22px;
    white-space: normal;
    color: rgb(255, 255, 255);
}

.skillbuild-combo-row {
    flex-direction: row;
    margin-top: 14px;
}

.skillbuild-combo-hex {
    width: 54px;
    height: 54px;
    margin-right: 14px;
}

.skill-description {
    flex-grow: 0;
    height: 150px;
    width: 100%;
    align-self: center;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Arts/Images/Sprites/UI/OutGame/UI_Back_Text.png?fileID=21300000&guid=522fda19571fbc24db0d164d903c2ea9&type=3#UI_Back_Text");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.2);
    margin-bottom: 12px;
}

.skillbuild-type-box {
    width: 80px;
    height: 80px;
    min-width: 80px;
    min-height: 80px;
    flex-shrink: 0;
    align-self: flex-start;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    padding-bottom: 6px;
    background-color: rgba(10, 20, 40, 1);
    border-width: 1px;
    border-color: rgb(58, 84, 135);
}

.skillbuild-type-icon {
    width: 65%;
    height: 65%;
    margin-bottom: 6px;
    -unity-background-scale-mode: scale-to-fit;
}

.skillbuild-type-caption {
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    color: rgb(255, 255, 255);
}

.skill-effect-heading {
    width: 95%;
    align-self: center;
    margin-top: 10px;
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.skill-description-label {
    width: 92%;
    align-self: center;
    padding-top: 4px;
    padding-bottom: 12px;
    padding-left: 16px;
    font-size: 18px;
    -unity-font-style: bold;
    white-space: normal;
    color: rgb(255, 255, 255);
}

.skill-tips-heading {
    width: 95%;
    align-self: center;
    margin-top: 10px;
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.skill-tips-label {
    width: 92%;
    align-self: center;
    padding-top: 4px;
    padding-bottom: 12px;
    padding-left: 16px;
    font-size: 18px;
    -unity-font-style: bold;
    white-space: normal;
    color: rgb(255, 255, 255);
}

.skillbuild-level-point-row {
    flex-direction: row;
    margin-bottom: 10px;
}

.skillbuild-info-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Arts/Images/Sprites/UI/OutGame/UI_Back_Text.png?fileID=21300000&guid=522fda19571fbc24db0d164d903c2ea9&type=3#UI_Back_Text");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.2);
    height: 40px;
    padding-left: 16px;
    padding-right: 16px;
    margin-bottom: 10px;
}

.skillbuild-info-row-half {
    flex-grow: 1;
    flex-basis: 0;
    margin-bottom: 0;
    border-width: 1px;
    border-color: rgb(58, 84, 135);
}

.skillbuild-info-row-left {
    margin-right: 8px;
}

.skillbuild-info-row-heading,
.skillbuild-info-row-value {
    color: rgb(255, 255, 255);
    font-size: 16px;
    -unity-font-style: bold;
}

.skillbuild-panel-button-row {
    flex-direction: row;
    justify-content: center;
    margin-top: auto;
}

.skillbuild-action-button {
    background-color: rgb(238, 240, 228);
    color: rgb(26, 26, 26);
    font-size: 20px;
    -unity-font-style: bold;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    min-width: 160px;
    min-height: 56px;
    padding-left: 24px;
    padding-right: 24px;
}

.skillbuild-reinforce-button {
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Arts/Images/Sprites/UI/OutGame/UI_Button_off.png?fileID=21300000&guid=04c54678165f5884ca0aafa6162a76c7&type=3#UI_Button_off");
    -unity-background-scale-mode: stretch-to-fill;
    color: rgb(40, 46, 66);
}

.skillbuild-slot-row {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 32px;
    background-color: rgba(0, 0, 0, 0);
    padding-top: 12px;
    padding-bottom: 12px;
}

.skillbuild-slot {
    width: 130px;
    height: 140px;
    min-width: 130px;
    min-height: 140px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Arts/Images/Sprites/UI/OutGame/UI_Back_Text.png?fileID=21300000&guid=522fda19571fbc24db0d164d903c2ea9&type=3#UI_Back_Text");
    -unity-background-scale-mode: stretch-to-fill;
    margin-left: 5px;
    margin-right: 5px;
}

.skillbuild-list-section {
    flex-grow: 0;
    flex-direction: column;
    justify-content: flex-start;
    background-color: rgba(0, 0, 0, 0);
    overflow: hidden;
}

.skillbuild-list-scrollview {
    flex-grow: 0;
    flex-direction: row;
    justify-content: flex-start;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Arts/Images/Sprites/UI/OutGame/UI_SkillView.png?fileID=21300000&guid=9a74b355f9dc4e147be4a02bc8af05f7&type=3#UI_SkillView");
    -unity-background-scale-mode: stretch-to-fill;
    overflow: hidden;
}

.skillbuild-bottom-row {
    flex-direction: row;
    justify-content: center;
    margin-top: 20px;
}

.skillbuild-bottom-row > .skillbuild-action-button {
    margin-left: 12px;
    margin-right: 12px;
}

.skill-element-slot {
    align-items: center;
    justify-content: center;
}

.skillbuild-slot-combo-row {
    flex-direction: row;
    justify-content: center;
    margin-top: 10px;
}

.skillbuild-slot-combo-hex {
    width: 34px;
    height: 34px;
    margin-left: 2px;
    margin-right: 2px;
}

.skillbuild-slot-icon-area {
    position: relative;
    width: 55%;
    height: 55%;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-right-radius: 50%;
    border-bottom-left-radius: 50%;
}

.skill-slot-icon {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.skill-slot-name {
    position: absolute;
    left: 4px;
    right: 4px;
    bottom: 4px;
    min-height: 18px;
    background-color: rgba(0, 0, 0, 0.65);
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 14px;
    white-space: normal;
    display: none;
}

.skill-slot-placeholder {
    color: rgb(255, 255, 255);
    font-size: 32px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.skill-element-slot.is-filled .skill-slot-placeholder {
    display: none;
}

.skill-element-slot.is-filled .skill-slot-name {
    display: flex;
}

.draggable {
    margin-left: 4%;
    margin-right: 4%;
}

.skill-element-container {
}

.skill-element-list {
    flex-shrink: 0;
}

/* 自動幅のグループに対する百分率余白を避け、末尾カードまでスクロール範囲に含める。 */
.skill-element-list .draggable {
    flex-shrink: 0;
    margin-left: 16px;
    margin-right: 16px;
}

.skill-group-divider {
    flex: 0 0 auto;
    width: 4px;
    height: 150px;
    align-self: center;
    margin-left: 16px;
    margin-right: 16px;
    background-color: rgb(120, 120, 120);
}

.skill-genre-filter-bar {
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    padding-left: 12px;
}

.skill-genre-filter-button-all,
.skill-genre-filter-button {
    flex: 0 0 auto;
    width: 180px;
    height: 52px;
    margin-right: 8px;
    padding: 0;
    align-items: center;
    justify-content: center;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Arts/Images/Sprites/UI/OutGame/UI_Panel_tab_off.png?fileID=21300000&guid=c27ffb2c61799194fbed912bd417a179&type=3#UI_Panel_tab_off");
    -unity-background-scale-mode: stretch-to-fill;
}

.skill-genre-filter-button-all {
    font-size: 27px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.skill-genre-filter-button-icon {
    width: 40px;
    height: 40px;
    align-self: center;
    -unity-background-scale-mode: scale-to-fit;
}

.skill-genre-filter-button-all.is-active,
.skill-genre-filter-button.is-active {
    background-image: url("project://database/Assets/Arts/Images/Sprites/UI/OutGame/UI_Panel_tab.png?fileID=21300000&guid=2634097f27d94f04cab60440a40fcb28&type=3#UI_Panel_tab");
}

.skill-group-container {
    flex: 0 0 auto;
    flex-direction: row;
    align-items: center;
    align-self: center;
    height: 174px;
    padding-left: 12px;
    padding-right: 12px;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(120, 120, 120);
    border-right-color: rgb(120, 120, 120);
    border-top-color: rgb(120, 120, 120);
    border-bottom-color: rgb(120, 120, 120);
}
