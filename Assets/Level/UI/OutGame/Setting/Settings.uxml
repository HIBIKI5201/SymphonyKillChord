<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="root" style="flex-grow: 1; flex-direction: column;">
        <ui:VisualElement name="CategoryBar" style="flex-grow: 0; width: 100%; height: 10%; flex-direction: column;">
            <ui:Button text="Button" name="AudioCategory" style="flex-grow: 0; flex-shrink: 1;"/>
            <ui:Button text="Button" name="ScreenCategory" style="flex-grow: 0; flex-shrink: 1;"/>
            <ui:Button text="Button" name="KeyCategory" style="flex-shrink: 1;"/>
        </ui:VisualElement>
        <ui:VisualElement name="Content" style="flex-grow: 1; width: 100%; height: 90%;">
            <ui:VisualElement name="ScreenPage" style="flex-grow: 1; width: 100%; height: 100%; display: none;"/>
            <ui:VisualElement name="AudioPage" style="flex-grow: 1; width: 100%; height: 100%; display: none;"/>
            <ui:VisualElement name="KeyPage" style="flex-grow: 1; width: 100%; height: 100%; display: none;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
