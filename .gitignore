# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# ビルドログなどの診断ログ (ルート直下に出力されることがあり、巨大かつ
# 各自の絶対パスを含むため共有しない)
*.log

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/[Mm]emoryCaptures/

# Recordings can get excessive in size
/[Rr]ecordings/

# Assets/AssetStoreTools はサブモジュール（SymphonyKillChord_AssetStoreTools）で管理するため、ここでは無視しない。

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/
.vscode/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/

*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

ExportedPackages/

# JetBrains IDEs (IntelliJ, Rider, etc.)
.idea/
.utmp/

/SinfoniaOperator/sinfonia-operator.secrets.json

# Android の署名鍵（アップロード鍵）。鍵と証明書はリポジトリに置かない。
*.jks
*.keystore
*.pem
*.p12

# NotionMarkdownWriter が pull した編集用の作業ファイル。
/SinfoniaOperator/.notion-work/

# CRI Atom Craft のプロジェクトを Assets 下に置くと、Unity が素材 wav を取り込んでしまうので除外する。
# プロジェクトは下の Sound/CRIAtomCraft/ に置く。
/[Aa]ssets/SymphonyKillChord/
/[Aa]ssets/SymphonyKillChord.meta
# CRI Atom Craft のプロジェクト（Sound/CRIAtomCraft/）は、Atom Craft で開くのに要る
# .atmcproject・.atmcglobal・WorkUnits（素材 wav を含む）だけを入れる。キャッシュ・ビルド出力・
# 自動バックアップ・セッション・個人設定は Atom Craft が作り直すので除外する。
# ランタイムが読む .acb/.acf は Assets/StreamingAssets に置く。
/Sound/CRIAtomCraft/**/*_Cache/
/Sound/CRIAtomCraft/**/*_Backup/
/Sound/CRIAtomCraft/*/Public/
/Sound/CRIAtomCraft/*/Session/
/Sound/CRIAtomCraft/**/*.atmcuser
/Sound/CRIAtomCraft/**/*.user_settings
/Sound/CRIAtomCraft/**/*.awbtmp
__MACOSX/
.DS_Store
Docs/NotionSpecifications/
Docs/DiscordLog/


# Python (scripts/)
__pycache__/
*.py[cod]

# Claude Code のローカル設定（各自の環境依存のため共有しない）
.claude/settings.local.json

# Hot Reload (有償アセット。各自でインストールするためリポジトリでは共有しない)
Packages/com.singularitygroup.hotreload/

# Entities のSubSceneベイクで生成されるキャッシュ
Assets/SceneDependencyCache/
Assets/SceneDependencyCache.meta

# uloop-cli の出力
.uloop/

# IDE(Unity/Rider)が自動生成するソリューションファイル
*.slnx
# Docs/ は基本 ignore。エージェント出力の Docs/agent/ だけは追跡する（構成は Docs/agent/README.md）
Docs/*
!Docs/agent/
